 #include <IOKit/IOLib.h>
 #include <kern/thread.h>
 #include <pexpert/pexpert.h>
+#include <libkern/c++/OSKext.h>
+
+/*
+ * The SWEET kernel comes from the macOS configuration (no NO_KEXTD):
+ * IOStartIOKit adds a busy count to the registry root until the IOKit daemon
+ * (kernelmanagerd) sends its personalities, and iOS has no kernelmanagerd.
+ * The registry then never goes quiet, so SystemConfiguration's
+ * __wait_for_IOKit_to_quiesce runs into its timeout (Settings → About stalled
+ * 2-4 min on fajita, SWEET BUSY showed only the root). Do once what the
+ * daemon's first request would do (OSKext.cpp: setIOKitDaemonActive +
+ * iokitDaemonLaunched). Boot-arg sweetiokitd=N seconds (fajita default 20,
+ * sweet default 0 = off).
+ */
+static void
+sweet_iokitd_stand_in(void *arg, wait_result_t wr __unused)
+{
+	IOSleep((uint32_t)(uintptr_t)arg * 1000);
+	UInt32 busy = IOService::getServiceRoot()->getBusyState();
+	if (OSKext::iokitDaemonActive() || busy == 0) {
+		IOLog("SWEET: IOKit daemon stand-in not needed (active=%d root busy=%u)\n",
+		    OSKext::iokitDaemonActive(), (unsigned)busy);
+		return;
+	}
+	OSKext::setIOKitDaemonActive();
+	IOService::iokitDaemonLaunched();
+	IOLog("SWEET: IOKit daemon stand-in: deferred matching started, root busy %u -> %u\n",
+	    (unsigned)busy, (unsigned)IOService::getServiceRoot()->getBusyState());
+}
+
+/* The ADT root's properties live on the IOPlatformExpertDevice (our provider). */
+static bool
+sweet_root_compatible(IOService *provider, const char *want)
+{
+	OSData *compat = OSDynamicCast(OSData, provider->getProperty("compatible"));
+	if (compat == NULL) {
+		return false;
+	}
+	const char *p = (const char *)compat->getBytesNoCopy();
+	unsigned len = compat->getLength();
+	for (unsigned i = 0; i < len; i += (unsigned)strnlen(p + i, len - i) + 1) {
+		if (strncmp(p + i, want, len - i) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
 

+/*
+ * One plain 32-bit load/store per register, never post-indexed or paired: on fajita (SDM845) the hypervisor
+ * traps EL1 accesses to the apps SMMU and emulates them from the abort syndrome, which is only valid for
+ * single loads/stores without writeback. The C copy loop compiled to `ldr w10, [x23], #4` on the device
+ * mapping; reading the SMMU through /dev/pmem then reset the SoC into crash-dump mode (2026-11-22, twice).
+ * Same as Linux readl/writel.
+ */
+static inline uint32_t
+pm_ld32(const volatile uint32_t *p)
+{
+	uint32_t v;
+	__asm__ volatile ("ldr %w0, [%1]" : "=r"(v) : "r"(p) : "memory");
+	return v;
+}
+
+static inline void
+pm_st32(volatile uint32_t *p, uint32_t v)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r"(v), "r"(p) : "memory");
+}
+
 static int
 pm_rw(struct uio *uio, bool write)
 {

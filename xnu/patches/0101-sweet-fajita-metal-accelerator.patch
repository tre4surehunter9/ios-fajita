+/* ---- Metal (sweetmtl=2) ---- */
+
+/*
+ * What Metal.framework enumerates (MTLRegisterDevices): it loads
+ * /System/Library/Extensions/<MetalPluginName>.bundle and asks its
+ * <MetalPluginClassName> for a device with this service. As ios-flame 0096/0116.
+ */
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+class SweetMetal : public IOAcceleratorES {
+	OSDeclareDefaultStructors(SweetMetal);
+
+public:
+	IOService *probe(IOService *provider, SInt32 *score) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetMetal, IOAcceleratorES);
+
+IOService *
+SweetMetal::probe(IOService *provider, SInt32 *score)
+{
+	uint32_t gpu = 0, mtl = 0;
+	PE_parse_boot_argn("sweetgpu", &gpu, sizeof(gpu));
+	PE_parse_boot_argn("sweetmtl", &mtl, sizeof(mtl));
+	return gpu >= 3 && mtl == 2 && sweet_board_is("oneplus,fajita") ? IOService::probe(provider, score) : NULL;
+}
+
+bool
+SweetMetal::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty("MetalPluginName", "SweetMetal2");
+	setProperty("MetalPluginClassName", "SweetMTL2Device");
+	setProperty("IOGLBundleName", "SweetMetal2");
+	setProperty("model", "Adreno 630");
+	setProperty(kIOUserClientClassKey, "SweetGPUUserClient");
+	registerService();
+	IOLog("SWEET GPU: IOAcceleratorES published for Metal (MetalPluginName SweetMetal2)\n");
+	return true;
+}

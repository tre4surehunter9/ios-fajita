+/*
+ * sweetmtl=2: the GPU renders the surfaces (SweetMetal2.bundle, imports of
+ * the client's pages) while this copy reads them through the cacheable
+ * kernel view, so lines the CPU still holds would be stale: clean+invalidate
+ * the source rows first (lines are physically tagged; the client cleaned its
+ * own writes before the GPU used them, so nothing dirty is lost).
+ */
+static int
+sweet_fb_gpu_surfaces(void)
+{
+	static int v = -1;
+	if (v < 0) {
+		uint32_t mtl = 0;
+		PE_parse_boot_argn("sweetmtl", &mtl, sizeof(mtl));
+		v = mtl == 2;
+	}
+	return v;
+}

+/*
+ * fajita, boot-arg sweetcharge=1: the input current limit from the detected charger type, as mainline's
+ * smb2_status_change_work: SDP (PC port) 500 mA, CDP / DCP / OCP / float 1.5 A (USBIN_CURRENT_LIMIT_CFG 0x1370,
+ * 25 mA steps). APSD not done yet: one rerun (CMD_APSD 0x1341 bit 0), checked again on the next poll (30 s).
+ * Mainline's fast-charge cap (1 A, "fire hazard") and the rest of its init sequence are not touched here.
+ */
+void
+SweetBattery::chargerSetup(void)
+{
+	uint8_t apsd = 0, result = 0, cfg = 0;
+	if (sweet_spmi_read(2, 0x1307, &apsd) || sweet_spmi_read(2, 0x1308, &result) ||
+	    sweet_spmi_read(2, 0x1370, &cfg)) {
+		return;
+	}
+	if (!(apsd & 1)) {
+		if (fApsdReruns < 3) {
+			int rc = sweet_spmi_write(2, 0x1341, 1);
+			fApsdReruns++;
+			IOLog("SWEET CHG: APSD not done (%#x): rerun %u -> %d\n", apsd, fApsdReruns, rc);
+		}
+		return;
+	}
+	result &= 0x7f;
+	unsigned ma = (result & 0x1e) ? 1500 : 500;	/* CDP 0x04, DCP 0x08, OCP 0x02, float 0x10; else SDP */
+	uint8_t want = (uint8_t)(ma / 25);
+	if (cfg == want) {
+		return;
+	}
+	int rc = sweet_spmi_write(2, 0x1370, want);
+	uint8_t icl = 0, now = 0;
+	(void)sweet_spmi_read(2, 0x1370, &now);
+	(void)sweet_spmi_read(2, 0x1607, &icl);
+	IOLog("SWEET CHG: type %#x -> input limit %u mA (cfg %u -> %u mA, write %d), ICL in effect %u mA\n",
+	    result, ma, cfg * 25u, now * 25u, rc, icl * 25u);
+}

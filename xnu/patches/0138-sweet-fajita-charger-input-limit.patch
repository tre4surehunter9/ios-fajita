index f8b7a84..25fd469 100644
--- a/bsd/dev/sweet_spmi.c
+++ b/bsd/dev/sweet_spmi.c
@@ -129,3 +129,63 @@ sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
 	return -1;
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * fajita: one PMIC register write, for the PMI8998 charger's input current limit only (SweetBattery with
+ * boot-arg sweetcharge=1). Allowlist: USID 2, USBIN_CURRENT_LIMIT_CFG 0x1370 and CMD_APSD 0x1341 (mainline
+ * qcom_pmi8998_charger.c smb2_set_current_limit / APSD rerun). Linux spmi-pmic-arb v5: the APID's own channel in
+ * "chnls" (0x0c600000 + 0x10000 * APID), only when this EE (0) owns the APID; WDATA0 at +0x10, then the command
+ * (EXT_WRITEL = opcode 0, byte count 0) at +0x0, STATUS at +0x8 (bit 0 done, bits 1-3 errors).
+ */
+#define SP_CHNLS_PA 0x0c600000u
+int sweet_spmi_write(unsigned sid, unsigned addr, uint8_t val);
+
+int
+sweet_spmi_write(unsigned sid, unsigned addr, uint8_t val)
+{
+	if (!sp_ready || sid != 2 || (addr != 0x1370 && addr != 0x1341) || !sweet_board_is("oneplus,fajita")) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | (addr >> 8));
+	if (apid == SP_NO_APID || sp_poisoned[apid] || (sp_rd(sp_cfg, 0x700u + 4u * apid) & 7u) != 0) {
+		IOLockUnlock(sp_lock);
+		printf("SWEET BATTERY: SPMI write sid=%u addr=%#x refused (APID %u not ours)\n", sid, addr, apid);
+		return -1;
+	}
+	/* ml_io_map mappings are permanent: one per APID, kept (only two registers ever come here). */
+	static uint16_t ch_apid = SP_NO_APID;
+	static vm_offset_t ch_va;
+	if (ch_apid != apid) {
+		ch_va = ml_io_map(SP_CHNLS_PA + 0x10000u * apid, 0x1000);
+		ch_apid = ch_va ? apid : SP_NO_APID;
+	}
+	vm_offset_t ch = ch_va;
+	if (!ch || ch_apid != apid) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x10u) = val;			/* WDATA0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x0u) = (addr & 0xffu) << 4;	/* EXT_WRITEL, BC=0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(ch, 0x08u);
+		if (status & 1u) {
+			IOLockUnlock(sp_lock);
+			if (status & 0x0eu) {
+				printf("SWEET BATTERY: SPMI write sid=%u addr=%#x status %#x\n", sid, addr, status);
+				return -1;
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("SWEET BATTERY: SPMI write timeout sid=%u addr=%#x APID=%u disabled\n", sid, addr, apid);
+	IOLockUnlock(sp_lock);
+	return -1;
+}
+#endif

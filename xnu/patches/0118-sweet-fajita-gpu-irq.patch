@@ -1550,6 +1561,68 @@ extern uint64_t sweet_fb_presents, sweet_fb_copy_ns;
 #define RBBM_INT_CLEAR_CMD	0x0037
 #define PERF_CP_ALWAYS_COUNT	0
 
+/*
+ * 0118: the GPU interrupt. mainline sdm845.dtsi gpu: interrupts = <GIC_SPI 300 IRQ_TYPE_LEVEL_HIGH> (INTID
+ * 332). TrustZone owns Group 0, so as the timer and IPIs it reaches sleh_irq as a Group 1 IRQ through
+ * sweet_spi_hook. Distributor (GICD 0x17a00000, GICv3: ICFGR 0xc00, IPRIORITYR 0x400, IROUTER 0x6000,
+ * ISENABLER 0x100): level, an NS priority, routed to CPU0 (MPIDR 0), enabled, then read back: a secure
+ * (Group 0) SPI reads as disabled from the non-secure side and the GPU keeps polling. On the GPU:
+ * RBBM_INT_0_MASK (0x38) = CP_CACHE_FLUSH_TS (bit 20), and each submission's fence CACHE_FLUSH_TS carries
+ * the IRQ bit (msm a6xx_submit). The handler clears RBBM_INT_0 (RBBM_INT_CLEAR_CMD) before the EOI and wakes
+ * fence waiters. Boot-arg sweetgpuirq=0: polling as before.
+ */
+#define GPU_INTID		332u
+#define GICD_PA			0x17a00000ULL
+#define RBBM_INT_0_MASK		0x0038
+#define INT_CP_CACHE_FLUSH_TS	(1u << 20)
+
+extern void (*sweet_spi_hook)(uint32_t intid);
+
+static void
+gpu_irq(uint32_t intid)
+{
+	if (intid != GPU_INTID) {
+		return;
+	}
+	uint32_t st = rd(GR(RBBM_INT_0_STATUS));
+	wr(GR(RBBM_INT_CLEAR_CMD), st);
+	gpu_irq_count++;
+	thread_wakeup((event_t)&gpu_irq_event);
+}
+
+static void
+gpu_irq_setup(void)
+{
+	uint32_t on = 1;
+	PE_parse_boot_argn("sweetgpuirq", &on, sizeof(on));
+	vm_offset_t gicd = on ? ml_io_map(GICD_PA, 0x10000) : 0;
+	if (gicd == 0) {
+		return;
+	}
+	uint32_t n = GPU_INTID, bit = 1u << (n % 32);
+	uint32_t group = rd(gicd + 0x80 + 4 * (n / 32)) & bit;
+	vm_offset_t cfg = gicd + 0xc00 + 4 * (n / 16);
+	wr(cfg, rd(cfg) & ~(2u << (2 * (n % 16))));		/* level */
+	vm_offset_t pri = gicd + 0x400 + (n & ~3u);
+	uint32_t sh = 8 * (n % 4);
+	wr(pri, (rd(pri) & ~(0xffu << sh)) | (0xa0u << sh));
+	wr(gicd + 0x6000 + 8 * n, 0);				/* IROUTER: CPU0 */
+	wr(gicd + 0x6000 + 8 * n + 4, 0);
+	wr(GR(RBBM_INT_CLEAR_CMD), 0xffffffffu);
+	wr(GR(RBBM_INT_0_MASK), INT_CP_CACHE_FLUSH_TS);
+	sweet_spi_hook = gpu_irq;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(gicd + 0x100 + 4 * (n / 32), bit);			/* ISENABLER */
+	bool enabled = (rd(gicd + 0x100 + 4 * (n / 32)) & bit) != 0;
+	if (!enabled) {
+		wr(GR(RBBM_INT_0_MASK), 0);
+		sweet_spi_hook = NULL;
+	}
+	gpu_irq_on = enabled;
+	printf("SWEET GPU: interrupt INTID %u: group bit %u, %s\n", n, group ? 1 : 0,
+	    enabled ? "enabled, fences wake waiters" : "NOT ENABLED (secure?), polling as before");
+}

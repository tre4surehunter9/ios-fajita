+	}
 	uint32_t fsr = rd(CB1 + CB_FSR), far_lo = rd(CB1 + CB_FAR), far_hi = rd(CB1 + CB_FAR + 4);
 	uint32_t fsynr = rd(CB1 + 0x68);
 	if (fsr) {
 		wr(CB1 + CB_FSR, fsr);
 	}
-	snprintf(buf, len, " | gpu %llu MHz, int0 0x%08x, hw_fault 0x%x, cb1 fsr 0x%x far 0x%x%08x fsynr0 0x%x", mhz,
-	    ints, rd(GR(CP_HW_FAULT)), fsr, far_hi, far_lo, fsynr);
+	static uint64_t irq_last;
+	uint64_t irqs = gpu_irq_count;
+	snprintf(buf, len, " | gpu %llu MHz, irqs %llu%s, int0 0x%08x, hw_fault 0x%x, cb1 fsr 0x%x far 0x%x%08x fsynr0 0x%x",
+	    mhz, irqs - irq_last, gpu_irq_on ? "" : " (polling)", ints, rd(GR(CP_HW_FAULT)), fsr, far_hi, far_lo, fsynr);
+	irq_last = irqs;
 }
 

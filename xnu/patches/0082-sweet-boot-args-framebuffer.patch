diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 023086f..592eaa5 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -514,11 +514,18 @@ LEXT(start_first_cpu)
 	mov		x21, #0
 
 #if defined(SWEET)
-	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	/*
+	 * Stage 0: white 64x32 band at the bottom of the boot_args framebuffer,
+	 * no stack or page tables needed.
+	 */
+	ldr		x0, [x20, BA_VIDEO_BASE]
+	cbz		x0, Lsweet_mark_done
+	ldr		x4, [x20, BA_VIDEO_ROWBYTES]
+	ldr		x2, [x20, BA_VIDEO_HEIGHT]
+	sub		x2, x2, #32
+	madd	x0, x2, x4, x0
 	mov		w1, #-1
 	mov		x2, #32
-	mov		x4, #4320
 Lsweet_mark_row:
 	mov		x3, #64
 	mov		x5, x0
@@ -530,6 +537,7 @@ Lsweet_mark_pixel:
 	subs	x2, x2, #1
 	b.ne	Lsweet_mark_row
 	dsb		sy
+Lsweet_mark_done:
 #endif
 
 	// Set low reset vector before attempting any loads
@@ -685,14 +693,19 @@ Lkernelcache_base_found:
 	 * create_bootstrap_mapping would replace the RAM L2 table.
 	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
+	 * The block is the one holding boot_args->Video.v_baseAddr (sweet
+	 * 0x9c000000, fajita 0x9d400000 -> same block 0x9c000000).
 	 */
-	MOV64	x10, 0x9c000000
+	ldr		x10, [x20, BA_VIDEO_BASE]
+	cbz		x10, Lsweet_fb_mapped
+	and		x10, x10, #~(ARM_TT_L2_OFFMASK)
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
 	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
 	add		x13, x25, #(2 * PGBYTES)
 	str		x11, [x13, x12, lsl #TTE_SHIFT]
+Lsweet_fb_mapped:
 #endif
 
 	/* Ensure TTEs are visible */
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 6928957..6ec159f 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -1,21 +1,27 @@
 /*
- * Redmi Note 10 Pro bootstrap console. No allocation, locks, ADT parsing or
+ * SWEET-family bootstrap console (Redmi Note 10 Pro, OnePlus 6T). No
+ * allocation, locks, ADT parsing or
  * per-CPU state: panic() can reach this before a current thread exists.
  * start.s maps the splash framebuffer VA=PA as Normal Non-Cacheable memory.
  * arm_vm_init installs a reserved kernel VA alias before removing TTBR0;
  * retain this console until the normal framebuffer serial console is ready.
+ * The framebuffer comes from boot_args->Video (filled by the shim per board);
+ * the defaults below are sweet's and only apply before arm_init reads it.
  */
 #include <arm64/sweet_early.h>
 
 #if defined(SWEET)
 #include <stdint.h>
 #include <kern/misc_protos.h>
+#include <arm64/proc_reg.h>
 
+static uint64_t early_fb_pa = 0x9c000000;
 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
+static unsigned int early_width = 1080u, early_height = 2400u, early_stride = 4320u / 4;
 #define EARLY_FB early_fb
-#define EARLY_WIDTH 1080u
-#define EARLY_HEIGHT 2400u
-#define EARLY_STRIDE (4320u / 4)
+#define EARLY_WIDTH early_width
+#define EARLY_HEIGHT early_height
+#define EARLY_STRIDE early_stride
 #define EARLY_SCALE 2u
 #define EARLY_CELL_W (8u * EARLY_SCALE)
 #define EARLY_CELL_H (16u * EARLY_SCALE)
@@ -125,11 +131,35 @@ sweet_early_panic(const char *fmt, va_list *args)
 	__asm__ volatile("dsb sy" ::: "memory");
 }
 
+void
+sweet_early_set_video(const boot_args *args)
+{
+	const Boot_Video *v = &args->Video;
+
+	/* The whole framebuffer must sit in the one 32MB block start.s maps. */
+	if (v->v_baseAddr == 0 || v->v_width == 0 || v->v_height <= 32 ||
+	    v->v_rowBytes < v->v_width * 4 ||
+	    ((v->v_baseAddr ^ (v->v_baseAddr + v->v_rowBytes * v->v_height - 1)) & ~ARM_TT_L2_OFFMASK)) {
+		return;
+	}
+	early_fb_pa = v->v_baseAddr;
+	early_fb = (volatile uint32_t *)(uintptr_t)v->v_baseAddr;
+	early_width = (unsigned int)v->v_width;
+	early_height = (unsigned int)v->v_height;
+	early_stride = (unsigned int)(v->v_rowBytes / 4);
+}
+
+uint64_t
+sweet_early_fb_pa(void)
+{
+	return early_fb_pa;
+}
+
 void
 sweet_early_relocate(uint64_t base)
 {
 	sweet_early_mark(8, "leaving bootstrap TTBR0");
-	early_fb = (volatile uint32_t *)(uintptr_t)base;
+	early_fb = (volatile uint32_t *)(uintptr_t)(base + (early_fb_pa & ARM_TT_L2_OFFMASK));
 	__asm__ volatile("dsb sy" ::: "memory");
 	sweet_early_mark(9, "kernel framebuffer VA live");
 }

+	    !sweet_fg_word(0x06, &flags) && !sweet_fg_word(0x02, &temp) &&
+	    !sweet_fg_word(0x0c, &rem) && !sweet_fg_word(0x0e, &full) &&
+	    !sweet_fg_word(0x10, &current);

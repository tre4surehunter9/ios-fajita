+	bool fullFlag = (flags & (1u << 9)) != 0;	/* FC */
+	bool discharging = (flags & 1u) != 0;		/* DSG */
+	/* No charger readout yet (PMI8998 SMB2 is not driven): external power is
+	 * inferred from the gauge, charging current or not discharging. */
+	bool charging = ma > 0 && !fullFlag;
+	bool external = ma > 0 || !discharging;
+	fMaxMah = full;
+	fDesignMah = 3700;	/* OnePlus 6T rated capacity */
+	fCentiC = (unsigned)((int)temp * 10 - 27315 > 0 ? (int)temp * 10 - 27315 : 0);

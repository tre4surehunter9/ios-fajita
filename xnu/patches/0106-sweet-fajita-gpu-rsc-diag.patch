+void sweet_rpmh_dump_slave(unsigned want);
 
 /* Live downstream DT has two positional reg entries, no reg-names. */
 #define RH_RSC_PA_SM7150   0x18220000u
@@ -467,4 +468,41 @@ sweet_rpmh_arc_levels(const char *res, uint16_t *levels, unsigned max)
 	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);

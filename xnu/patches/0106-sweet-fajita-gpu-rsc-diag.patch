+/* 0106 diagnostics: n registers from base (word stride), one line. */
+static void
+dump_regs(const char *what, vm_offset_t base, uint32_t first_word, unsigned n)
+{
+	char line[200];
+	int len = snprintf(line, sizeof(line), "SWEET GPU: %s @%#x:", what, first_word);
+	for (unsigned i = 0; i < n && len < (int)sizeof(line) - 10; i++) {
+		len += snprintf(line + len, sizeof(line) - (size_t)len, " %08x", rd(base + 4 * (first_word + i)));
+	}
+	printf("%s\n", line);
+}

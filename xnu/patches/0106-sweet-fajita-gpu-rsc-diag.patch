 }
+/* Diagnostics (0106): every cmd-db entry of one slave type (3 = ARC) with its address. */
+void
+sweet_rpmh_dump_slave(unsigned want)
+{
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	if (!rh_map()) {
+		for (unsigned i = 0; i < 8; ++i) {
+			uint32_t h = 8u + 16u * i;
+			unsigned slave = rh_db16(h);
+			if (!slave) {
+				break;
+			}
+			if (slave != want) {
+				continue;
+			}
+			uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+			unsigned count = rh_db16(h + 6);
+			if (!rh_range(entries, count * RH_DB_ENTRY)) {
+				break;
+			}
+			for (unsigned j = 0; j < count; ++j) {
+				uint32_t e = entries + RH_DB_ENTRY * j;
+				uint32_t k0 = rh_read(rh_db, e), k1 = rh_read(rh_db, e + 4);
+				char name[9];
+				for (unsigned c = 0; c < 8; c++) {
+					uint8_t ch = (uint8_t)((c < 4 ? k0 : k1) >> (8 * (c % 4)));
+					name[c] = (ch >= 0x20 && ch < 0x7f) ? (char)ch : (ch ? '?' : 0);
+				}
+				name[8] = 0;
+				printf("SWEET RPMH: cmd-db slave %u: %-8s addr %#x\n", slave, name, rh_read(rh_db, e + 16));
+			}
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+}

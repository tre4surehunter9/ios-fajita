+/*
+ * Bus bandwidth to the top level for the GPU (bsd/dev/sweet_a630.c): nothing
+ * else votes DDR (BCM MC0) or the memory NoC (SH0) for it, so the GPU's
+ * memory traffic ran at whatever ABL left. BCM command as mainline's
+ * BCM_TCS_CMD(commit, valid, x avg, y peak), both at the 14-bit maximum
+ * (the BCM caps it at its top level), as ios-flame's 0122.
+ */
+int
+sweet_rpmh_bcm_vote_top(const char *res)
+{
+	if (!res || !sweet_board_is("oneplus,fajita") || (strcmp(res, "MC0") && strcmp(res, "SH0"))) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (!rh_poisoned) {
+		error = rh_map();
+		if (!error) {
+			error = rh_lookup(res, RH_BCM, &address);
+		}
+		if (!error) {
+			const uint32_t offset = 0, value = 1u << 30 | 1u << 29 | 0x3fffu << 14 | 0x3fffu;
+			error = rh_send(address, 1, &offset, &value);
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	printf("SWEET RPMH: bus vote %s top -> %d\n", res, error);
+	return error;
+}

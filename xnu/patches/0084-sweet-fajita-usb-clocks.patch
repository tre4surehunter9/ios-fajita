+_Static_assert(sizeof(usb_cbcr_sdm845) == sizeof(usb_cbcr_sm7150), "clock tables");
+
+/* The ADT root compatible names the board (tools/mkadt.py). */
+static bool
+usb_board_is(const char *want)
+{
+	DTEntry root;
+	const char *compat;
+	unsigned int size;
+
+	if (SecureDTLookupEntry(NULL, "/", &root) != kSuccess ||
+	    SecureDTGetProperty(root, "compatible", (const void **)&compat, &size) != kSuccess) {
+		return false;
+	}
+	for (unsigned int i = 0; i < size; i += strnlen(compat + i, size - i) + 1) {
+		if (strncmp(compat + i, want, size - i) == 0) {
+			return true;
+		}
+	}
+	return false;
+}

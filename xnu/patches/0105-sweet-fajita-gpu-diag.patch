 /* SweetFramebuffer.cpp: panel presents and the time their CPU copies took. */
 extern uint64_t sweet_fb_presents, sweet_fb_copy_ns;
 
+#define CP_PERFCTR_CP_SEL0	0x08d0
+#define RBBM_PERFCTR_CP0	0x0400		/* lo, hi at 0x401 */
+#define RBBM_INT_CLEAR_CMD	0x0037
+#define PERF_CP_ALWAYS_COUNT	0
+
+static uint64_t
+gr_rd64(uint32_t word)
+{
+	uint32_t hi, lo;
+	do {
+		hi = rd(GR(word + 1));
+		lo = rd(GR(word));
+	} while (hi != rd(GR(word + 1)));
+	return ((uint64_t)hi << 32) | lo;
+}
+
+/*
+ * 0105 diagnostics on each 5-second line: the GPU core clock (CP perf
+ * counter 0 on PERF_CP_ALWAYS_COUNT, as mainline's hw_init selects it,
+ * against the GMU's 19.2 MHz counter), the RBBM_INT_0 bits latched since the
+ * last line (cleared after reading: 9 CP_HW_ERROR, 20 CACHE_FLUSH_TS = our
+ * fences, 23 RBBM_HANG_DETECT, 24 UCHE_OOB_ACCESS), CP_HW_FAULT, and the CP
+ * context bank's fault status/address (cleared after reading).
+ */
+static void
+stats_diag(char *buf, size_t len, uint64_t *cyc_last, uint64_t *ao_last)
+{
+	uint64_t cyc = gr_rd64(RBBM_PERFCTR_CP0), ao = sweet_gpu_timestamp();
+	uint64_t mhz = (ao > *ao_last && *ao_last) ? (cyc - *cyc_last) * 192 / ((ao - *ao_last) * 10) : 0;
+	*cyc_last = cyc;
+	*ao_last = ao;
+	uint32_t ints = rd(GR(RBBM_INT_0_STATUS));
+	wr(GR(RBBM_INT_CLEAR_CMD), ints);
+	uint32_t fsr = rd(CB1 + CB_FSR), far_lo = rd(CB1 + CB_FAR), far_hi = rd(CB1 + CB_FAR + 4);
+	uint32_t fsynr = rd(CB1 + 0x68);
+	if (fsr) {
+		wr(CB1 + CB_FSR, fsr);
+	}
+	snprintf(buf, len, " | gpu %llu MHz, int0 0x%08x, hw_fault 0x%x, cb1 fsr 0x%x far 0x%x%08x fsynr0 0x%x", mhz,
+	    ints, rd(GR(CP_HW_FAULT)), fsr, far_hi, far_lo, fsynr);
+}
+

 }
+/*
+ * An ARC resource's voltage levels (RPMH_REGULATOR_LEVEL_*), as mainline's
+ * a6xx_gmu_rpmh_read_arc: the aux data is an array of u16, trailing zeros
+ * dropped. Returns the count, 0 on error. For the GMU's performance table.
+ */
+int
+sweet_rpmh_arc_levels(const char *res, uint16_t *levels, unsigned max)
+{
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return 0;
+	}
+	unsigned n = 0;
+	uint32_t address = 0, off = 0, len = 0;
+	if (!rh_map() && !rh_lookup_aux(res, RH_ARC, &address, &off, &len)) {
+		n = len / 2;
+		if (n > max) {
+			n = max;
+		}
+		for (unsigned i = 0; i < n; i++) {
+			levels[i] = rh_db16(off + 2 * i);
+		}
+		while (n && levels[n - 1] == 0) {
+			n--;
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return (int)n;
+}

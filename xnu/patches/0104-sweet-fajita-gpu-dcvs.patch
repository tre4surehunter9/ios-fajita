+/*
+ * Phase 4: the GPU's clock. On a630 the GMU firmware sets the GPU core clock
+ * and its rails from a performance table the driver sends (HFI v1
+ * PERF_TABLE) and a DCVS vote; without them the core ran at its power-on
+ * clock (0103's stats: GPU busy 70-97 % at 300-550 ms per submission).
+ * Levels as mainline: index 0 is "off", then sdm845.dtsi's GPU OPPs with
+ * their RPMh levels, and the GMU's 200/400 MHz OPPs. Votes are built as
+ * a6xx_gmu_rpmh_arc_votes_init from this phone's own cmd-db level lists.
+ */
+int sweet_rpmh_arc_levels(const char *res, uint16_t *levels, unsigned max);
+
+#define NGPU_LEVELS		8
+#define NGMU_LEVELS		3
+static const uint32_t gpu_khz[NGPU_LEVELS] = { 0, 257000, 342000, 414000, 520000, 596000, 675000, 710000 };
+static const uint16_t gpu_rpmh[NGPU_LEVELS] = { 0, 64, 128, 192, 256, 320, 384, 416 };	/* LOW_SVS .. TURBO_L1 */
+static const uint32_t gmu_khz[NGMU_LEVELS] = { 0, 200000, 400000 };
+static const uint16_t gmu_rpmh[NGMU_LEVELS] = { 0, 48, 128 };				/* MIN_SVS, SVS */
+static bool perf_table_sent;
+
+static int
+arc_index(const uint16_t *arc, int n, unsigned level, bool clamp)
+{
+	for (int j = 0; j < n; j++) {
+		if (arc[j] >= level) {
+			return j;
+		}
+	}
+	return clamp ? n - 1 : -1;
+}
+
+/* (primary level << 16) | (secondary index << 8) | primary index, per frequency; 0 on success. */
+static int
+arc_votes(uint32_t *votes, const uint16_t *want, int count, const char *pri_id, const char *sec_id)
+{
+	uint16_t pri[16], sec[16];
+	int np = sweet_rpmh_arc_levels(pri_id, pri, 16), ns = sweet_rpmh_arc_levels(sec_id, sec, 16);
+	if (np <= 0 || ns <= 0) {
+		printf("SWEET GPU: cmd-db %s/%s levels missing (%d/%d)\n", pri_id, sec_id, np, ns);
+		return -1;
+	}
+	for (int i = 0; i < count; i++) {
+		int p = arc_index(pri, np, want[i], false);
+		if (p < 0) {
+			printf("SWEET GPU: level %u not in %s\n", want[i], pri_id);
+			return -1;
+		}
+		int s = arc_index(sec, ns, pri[p], true);
+		votes[i] = ((uint32_t)pri[p] << 16) | ((uint32_t)s << 8) | (uint32_t)p;
+	}
+	printf("SWEET GPU: %s %d levels (top %u), %s %d levels (top %u)\n", pri_id, np, pri[np - 1], sec_id, ns,
+	    sec[ns - 1]);
+	return 0;
+}
+
+/* HFI v1 PERF_TABLE then BW_TABLE (mainline's a630 "off" bus table), between FW_VERSION and TEST. */
+static void
+hfi_perf_tables(void)
+{
+	uint32_t gx[NGPU_LEVELS], cx[NGMU_LEVELS], r[4];
+	if (arc_votes(gx, gpu_rpmh, NGPU_LEVELS, "gfx.lvl", "mx.lvl") ||
+	    arc_votes(cx, gmu_rpmh, NGMU_LEVELS, "cx.lvl", "mx.lvl")) {
+		return;
+	}
+	uint32_t perf[42] = { 0 };				/* struct a6xx_hfi_msg_perf_table_v1 minus header */
+	perf[0] = NGPU_LEVELS;
+	perf[1] = NGMU_LEVELS;
+	for (int i = 0; i < NGPU_LEVELS; i++) {
+		perf[2 + 2 * i] = gx[i];
+		perf[3 + 2 * i] = gpu_khz[i];
+	}
+	for (int i = 0; i < NGMU_LEVELS; i++) {
+		perf[34 + 2 * i] = cx[i];
+		perf[35 + 2 * i] = gmu_khz[i];
+	}
+	uint32_t hp = hfi_cmd(4, perf, 42, r), ep = r[2];
+	uint32_t bw[159] = { 0 };				/* struct a6xx_hfi_msg_bw_table minus header */
+	bw[0] = 1;						/* bw_level_num */
+	bw[1] = 3;						/* cnoc_cmds_num */
+	bw[2] = 3;						/* ddr_cmds_num */
+	bw[3] = 0x05;						/* cnoc_wait_bitmask */
+	bw[4] = 0x07;						/* ddr_wait_bitmask */
+	const uint32_t cnoc_addr[3] = { 0x50034, 0x5007c, 0x5004c };
+	const uint32_t cnoc0[3] = { 0x40000000, 0, 0x40000000 }, cnoc1[3] = { 0x60000001, 0x20000001, 0x60000001 };
+	const uint32_t ddr_addr[3] = { 0x50000, 0x5005c, 0x5000c };
+	for (int i = 0; i < 3; i++) {
+		bw[5 + i] = cnoc_addr[i];			/* cnoc_cmds_addrs[6] at 5 */
+		bw[11 + i] = cnoc0[i];				/* cnoc_cmds_data[0][6] at 11 */
+		bw[17 + i] = cnoc1[i];				/* cnoc_cmds_data[1][6] at 17 */
+		bw[23 + i] = ddr_addr[i];			/* ddr_cmds_addrs[8] at 23 */
+		bw[31 + i] = 0x40000000;			/* ddr_cmds_data[0][8] at 31 */
+	}
+	uint32_t hb = hfi_cmd(3, bw, 159, r), eb = r[2];
+	perf_table_sent = hp && hb && ep == 0 && eb == 0;
+	printf("SWEET GPU: hfi PERF_TABLE 0x%x err %u (gx votes 0x%x .. 0x%x), BW_TABLE 0x%x err %u\n", hp, ep, gx[1],
+	    gx[NGPU_LEVELS - 1], hb, eb);
+}

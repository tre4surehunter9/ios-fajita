+				*aux_len = rh_db16(e + 20);
+			}
 			++matches;
 			printf("SWEET RPMH: %s addr=%#x slave=%u aux-version=%#x priority=%#x:%#x\n",
 			    res, addr, slave, rh_db16(h + 8),
@@ -423,4 +439,32 @@ sweet_rpmh_bcm_vote_top(const char *res)
 	printf("SWEET RPMH: bus vote %s top -> %d\n", res, error);

 	uint32_t h1 = hfi_cmd(1, fwver, 1, r), ver = r[3];
+	if (gpu_level >= 3) {
+		hfi_perf_tables();
+	}
 	uint32_t h2 = hfi_cmd(5, NULL, 0, r), test = r[3];
 	printf("SWEET GPU: hfi INIT 0x%x err %u, FW_VERSION 0x%x ver 0x%08x, TEST 0x%x data 0x%08x\n",
 	    h0, err, h1, ver, h2, test);
@@ -1450,6 +1550,38 @@ cp_stage(void)
 	wr(G(GMU_H2G_SET), 1u << OOB_GPU_ACK);					/* clear GPU_SET */
 }
 
+#define GMU_DCVS_ACK_OPTION	0x8ff0
+#define GMU_DCVS_PERF_SETTING	0x8ff4
+#define GMU_DCVS_BW_SETTING	0x8ff8
+#define GMU_DCVS_RETURN		0x8ffc
+#define OOB_DCVS_SET		23			/* legacy: set 23, ack/clear 31 */
+#define OOB_DCVS_ACK		31
+
+/*
+ * a6xx_gmu_set_freq, legacy path: DCVS vote for a perf index (sweetgpufreq=,
+ * default the top, 710 MHz), bus left to the firmware (0xff), DCVS OOB set +
+ * clear. gpucc 0x101c/0x1020 is downstream's gx_gfx3d RCG (not in mainline's
+ * gpucc-sdm845.c: the GMU owns it); only read, as a before/after hint.
+ */
+static uint32_t gpu_freq_index = NGPU_LEVELS - 1;
+
+static void
+gpu_set_freq(void)
+{
+	uint32_t idx = gpu_freq_index < NGPU_LEVELS ? gpu_freq_index : NGPU_LEVELS - 1;
+	uint32_t rcg0 = rd(w.gpucc + 0x101c), cfg0 = rd(w.gpucc + 0x1020);
+	wr(G(GMU_DCVS_ACK_OPTION), 0);
+	wr(G(GMU_DCVS_PERF_SETTING), (3u << 28) | idx);
+	wr(G(GMU_DCVS_BW_SETTING), 0xff);
+	wr(G(GMU_H2G_SET), 1u << OOB_DCVS_SET);
+	int rc = wait_bits(G(GMU_G2H_INFO), 1u << OOB_DCVS_ACK, true, 10000);
+	wr(G(GMU_G2H_CLR), 1u << OOB_DCVS_ACK);
+	wr(G(GMU_H2G_SET), 1u << OOB_DCVS_ACK);			/* a6xx_gmu_clear_oob */
+	printf("SWEET GPU: DCVS %u MHz (index %u): oob %s, return %d, gfx3d rcg 0x%x/0x%x -> 0x%x/0x%x\n",
+	    gpu_khz[idx] / 1000, idx, rc ? "NOT ACKED" : "acked", (int)rd(G(GMU_DCVS_RETURN)), rcg0, cfg0,
+	    rd(w.gpucc + 0x101c), rd(w.gpucc + 0x1020));
+}
+

@@ -586,6 +605,117 @@ static const struct cdevsw sweet_ufs_cdevsw = {
 	.d_type       = D_DISK,
 };
 
+/* ---- fajita: read-only modem partitions (boot-arg sweetufsparts=1) ---- */
+static struct {
+	const char *name;
+	uint8_t lun;
+	bool found;
+	uint64_t first, n;
+} su_part[] = { { "modemst1" }, { "modemst2" }, { "fsg" }, { "fsc" } };
+#define SU_NPART        (sizeof(su_part) / sizeof(su_part[0]))
+
+static int
+sweet_ufs_part_open(dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	unsigned m = (unsigned)minor(dev);
+	if (m >= SU_NPART || !su_part[m].found) {
+		return ENXIO;
+	}
+	return (flags & FWRITE) ? EROFS : 0;
+}
+
+static int
+sweet_ufs_part_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+sweet_ufs_part_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	unsigned m = (unsigned)minor(dev);
+	if (m >= SU_NPART || !su_part[m].found || uio_offset(uio) < 0) {
+		return ENXIO;
+	}
+	uint64_t bytes = su_part[m].n * UFS_BLOCK;
+	int error = 0;
+	while (!error && uio_resid(uio) > 0 && (uint64_t)uio_offset(uio) < bytes) {
+		uint64_t pos = (uint64_t)uio_offset(uio);
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint64_t n = MIN((uint64_t)uio_resid(uio), MIN((uint64_t)(BOUNCE_SIZE - skip), bytes - pos));
+		uint32_t blocks = (uint32_t)((skip + n + UFS_BLOCK - 1) / UFS_BLOCK);
+		lck_mtx_lock(&sweet_ufs_lock);
+		su.lun = su_part[m].lun;
+		error = ufs_read_blocks(su_part[m].first + pos / UFS_BLOCK, blocks);
+		su.lun = su.root_lun;
+		if (!error) {
+			error = uiomove((const char *)(su.dma + DMA_BOUNCE) + skip, (int)n, uio);
+		}
+		lck_mtx_unlock(&sweet_ufs_lock);
+	}
+	return error;
+}
+
+static const struct cdevsw sweet_ufs_part_cdevsw = {
+	.d_open       = sweet_ufs_part_open,
+	.d_close      = sweet_ufs_part_close,
+	.d_read       = sweet_ufs_part_read,
+	.d_write      = eno_rdwrt,
+	.d_ioctl      = eno_ioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = 0,
+};
+
+static void
+sweet_ufs_parts_init(void)
+{
+	uint32_t on = 0;
+	PE_parse_boot_argn("sweetufsparts", &on, sizeof(on));
+	if (on != 1) {
+		return;
+	}
+	static const uint8_t tur[6] = { 0x00 };
+	unsigned found = 0;
+	lck_mtx_lock(&sweet_ufs_lock);
+	for (uint8_t lun = 0; lun < 8 && found < SU_NPART; lun++) {
+		su.lun = lun;
+		int error = EIO;
+		for (int i = 0; i < 3 && (error = ufs_scsi(tur, sizeof(tur), 0, false)); i++) {
+		}
+		for (unsigned i = 0; !error && i < SU_NPART; i++) {
+			if (!su_part[i].found &&
+			    ufs_gpt_find(su_part[i].name, &su_part[i].first, &su_part[i].n, true) == 0) {
+				su_part[i].lun = lun;
+				su_part[i].found = true;
+				found++;
+			}
+		}
+	}
+	su.lun = su.root_lun;
+	lck_mtx_unlock(&sweet_ufs_lock);
+	int major = found ? cdevsw_add(-1, &sweet_ufs_part_cdevsw) : -1;
+	for (unsigned i = 0; i < SU_NPART; i++) {
+		if (!su_part[i].found) {
+			printf("SWEET UFS: partition %s not found\n", su_part[i].name);
+			continue;
+		}
+		printf("SWEET UFS: %s on LUN %u: first block 0x%llx, %llu bytes, read-only /dev/ufs_%s\n",
+		    su_part[i].name, su_part[i].lun, su_part[i].first, su_part[i].n * UFS_BLOCK, su_part[i].name);
+		if (major >= 0) {
+			char node[24];
+			snprintf(node, sizeof(node), "ufs_%s", su_part[i].name);
+			devfs_make_node(makedev(major, i), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0400, "%s", node);
+		}
+	}
+}
+
 static int
 sweet_ufs_init(void)
 {
@@ -621,7 +751,7 @@ sweet_ufs_init(void)
 		return ENOMEM;
 	}
 	su.dma_pa = ptoa_64(pn);
-	su.lun = 0;
+	su.lun = su.root_lun = 0;
 	su.secsize = DEV_BSIZE;
 
 	lck_mtx_lock(&sweet_ufs_lock);
@@ -657,6 +787,7 @@ sweet_ufs_init(void)
 	printf("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, %s, DMA at 0x%llx\n",
 	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20,
 	    su.writable ? "read-write" : "read-only", su.dma_pa);
+	sweet_ufs_parts_init();   /* fajita modem partitions, read-only (sweetufsparts=1) */
 	sweet_log_start();
 	sweet_sample_start();
 	/* Input drivers (HID services in iokit/Kernel/arm/hid/SweetHID.cpp). */

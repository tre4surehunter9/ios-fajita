  * Writes are refused unless boot-arg ufsrw=1 is set. Every write is checked
  * against the partition bounds again right before it is issued, so nothing
  * outside the named partition can be written.
+ *
+ * fajita, boot-arg sweetufsparts=1: the modem's own partitions (modemst1,
+ * modemst2, fsg, fsc: rmtfs, phone/wifi) are looked up on LUNs 0-7 and shown
+ * READ-ONLY as /dev/ufs_<name> (root 0400), so they can be copied off the
+ * phone once. No write path exists for them; writes stay on the root LUN.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -105,7 +110,8 @@ static struct {
 	vm_offset_t regs;
 	vm_offset_t dma;                        /* kernel VA of the DMA allocation */
 	uint64_t dma_pa;
-	uint8_t lun;
+	uint8_t lun;                            /* LUN of the next command */
+	uint8_t root_lun;                       /* the root partition's LUN: the only one written */
 	uint8_t tag;
 	uint64_t first_block, nblocks;          /* partition, in 4 KiB device blocks */
 	uint32_t secsize;                       /* logical sector size for the BSD layer */
@@ -281,7 +287,7 @@ ufs_read_blocks(uint64_t lba, uint32_t count)
 static int
 ufs_write_blocks(uint64_t lba, uint32_t count)
 {
-	if (!su.writable || !su.nblocks || count == 0 || count > BOUNCE_SIZE / UFS_BLOCK ||
+	if (!su.writable || !su.nblocks || su.lun != su.root_lun || count == 0 || count > BOUNCE_SIZE / UFS_BLOCK ||
 	    lba < su.first_block || lba - su.first_block >= su.nblocks ||
 	    count > su.nblocks - (lba - su.first_block) || lba + count - 1 > UINT32_MAX) {
 		printf("SWEET UFS: refusing write of %u blocks at 0x%llx\n", count, lba);
@@ -302,8 +308,17 @@ ufs_sync_cache(void)
 	return ufs_scsi(cdb, sizeof(cdb), 0, false);
 }
 
+static int ufs_gpt_find(const char *want, uint64_t *first_out, uint64_t *n_out, bool quiet);
+
 static int
 ufs_find_partition(const char *want)
+{
+	return ufs_gpt_find(want, &su.first_block, &su.nblocks, false);
+}
+
+/* The GPT of LUN su.lun (caller holds the lock): partition want's first block and size, in 4 KiB blocks. */
+static int
+ufs_gpt_find(const char *want, uint64_t *first_out, uint64_t *n_out, bool quiet)
 {
 	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
 	int error = ufs_read_blocks(1, 1);
@@ -311,7 +326,9 @@ ufs_find_partition(const char *want)
 		return error;
 	}
 	if (memcmp(b, "EFI PART", 8) != 0) {
-		printf("SWEET UFS: LUN %u has no GPT\n", su.lun);
+		if (!quiet) {
+			printf("SWEET UFS: LUN %u has no GPT\n", su.lun);
+		}
 		return ENXIO;
 	}
 	uint64_t entry_lba;
@@ -348,11 +365,13 @@ ufs_find_partition(const char *want)
 		if (last < first) {
 			return ENXIO;
 		}
-		su.first_block = first;
-		su.nblocks = last - first + 1;
+		*first_out = first;
+		*n_out = last - first + 1;
 		return 0;

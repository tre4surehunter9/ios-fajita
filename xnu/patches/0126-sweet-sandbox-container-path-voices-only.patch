+ * others included, keeps ENOENT. sweetsbappex=0: never answer.
  */
 #define SWEET_SB_APPEX_PATH	"/private/var/mobile"
 
@@ -303,8 +305,14 @@ struct sweet_sb_container_args {
 	uint64_t pid, pidversion, buffer, size, flag;
 };
 
+static const char *const sweet_sb_container_extensions[] = {
+	"/SiriTTSService.framework/PlugIns/SiriTTSSynthesizerAU.appex/",
+	"/MacinTalk.framework/PlugIns/MacinTalkAUSP.appex/",
+	"/TextToSpeechKonaSupport.framework/PlugIns/KonaSynthesizer.appex/",
+};
+
 static bool
-sweet_proc_is_appex(struct proc *p)
+sweet_proc_wants_container_path(struct proc *p)
 {
 	vnode_t vp = proc_getexecutablevnode(p);
 	if (vp == NULLVP) {
@@ -312,7 +320,12 @@ sweet_proc_is_appex(struct proc *p)
 	}
 	char path[MAXPATHLEN];
 	int len = sizeof(path);
-	bool yes = vn_getpath(vp, path, &len) == 0 && strnstr(path, ".appex/", sizeof(path)) != NULL;
+	bool yes = false;
+	if (vn_getpath(vp, path, &len) == 0) {
+		for (size_t i = 0; i < sizeof(sweet_sb_container_extensions) / sizeof(sweet_sb_container_extensions[0]); i++) {
+			yes = yes || strnstr(path, sweet_sb_container_extensions[i], sizeof(path)) != NULL;
+		}
+	}
 	vnode_put(vp);
 	return yes;
 }

index 6115625..9a1fe10 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -27,7 +27,9 @@
 #include <kern/startup.h>
 #include <libkern/amfi/amfi.h>
 #include <mach/kern_return.h>
+#include <pexpert/pexpert.h>
 #include <sys/codesign.h>
+#include <sys/param.h>
 #include <sys/errno.h>
 #include <sys/mount.h>
 #include <sys/priv.h>
@@ -286,8 +288,61 @@ sweet_amfi_vnode_check_signature(struct vnode *vp, __unused struct label *label,
  */
 static uint64_t sweet_sandbox_seen;
 
+/*
+ * 0125: op 4, sandbox_container_path_for_pid / _for_audit_token (libsystem_sandbox 20H392): arg ->
+ * { u64 pid, u64 pid version, u64 buffer, u64 size, u64 flag }. PlugInKit's start-up check in an app
+ * extension needs it to succeed with a path longer than one byte, else it throws "plugin has invalid
+ * sandbox or container: error %d path %s" (the Siri voice extensions' crash loop: SiriTTSSynthesizerAU,
+ * MacinTalkAUSP, KonaSynthesizer); it only tests the path. So a process asking about itself whose
+ * executable is inside an .appex gets a real writable directory, as there are no containers here;
+ * everyone else, launchd's queries about others included, keeps ENOENT. sweetsbappex=0: never answer.
+ */
+#define SWEET_SB_APPEX_PATH	"/private/var/mobile"
+
+struct sweet_sb_container_args {
+	uint64_t pid, pidversion, buffer, size, flag;
+};
+
+static bool
+sweet_proc_is_appex(struct proc *p)
+{
+	vnode_t vp = proc_getexecutablevnode(p);
+	if (vp == NULLVP) {
+		return false;
+	}
+	char path[MAXPATHLEN];
+	int len = sizeof(path);
+	bool yes = vn_getpath(vp, path, &len) == 0 && strnstr(path, ".appex/", sizeof(path)) != NULL;
+	vnode_put(vp);
+	return yes;
+}
+
+static int
+sweet_sandbox_container_path(struct proc *p, user_addr_t arg)
+{
+	static int on = -1, logged;
+	if (on < 0) {
+		int v = 1;
+		PE_parse_boot_argn("sweetsbappex", &v, sizeof(v));
+		on = v != 0;
+	}
+	struct sweet_sb_container_args a;
+	if (!on || copyin(arg, &a, sizeof(a)) != 0 || a.pid != (uint64_t)proc_pid(p) ||
+	    a.size < sizeof(SWEET_SB_APPEX_PATH) || !sweet_proc_is_appex(p)) {
+		return ENOENT;
+	}
+	int error = copyout(SWEET_SB_APPEX_PATH, (user_addr_t)a.buffer, sizeof(SWEET_SB_APPEX_PATH));
+	if (logged < 32) {
+		logged++;
+		char name[32];
+		proc_name(proc_pid(p), name, sizeof(name));
+		printf("SWEET Sandbox: %s[%d] container path -> %s (%d)\n", name, proc_pid(p), SWEET_SB_APPEX_PATH, error);
+	}
+	return error;
+}
+
 static int
-sweet_sandbox_syscall(struct proc *p, int call, __unused user_addr_t arg)
+sweet_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
 {
 	if (call >= 0 && call < 64 && !(sweet_sandbox_seen & (1ULL << call))) {
 		sweet_sandbox_seen |= 1ULL << call;
@@ -297,6 +352,7 @@ sweet_sandbox_syscall(struct proc *p, int call, __unused user_addr_t arg)
 	}
 	switch (call) {
 	case 4:         /* container path (audit token / pid) */
+		return sweet_sandbox_container_path(p, arg);
 	case 5:         /* extension issue */
 	case 6:         /* extension consume */
 	case 0x43:      /* container expected */

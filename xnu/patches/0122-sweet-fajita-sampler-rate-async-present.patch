+/*
+ * 0122 non-blocking present (sweetfb_async=1, needs the GPU blit): the swap queues the blit into the buffer
+ * that is not on screen and returns; a worker thread waits for that blit's fence (woken by the GPU
+ * interrupt), flips VIG0 and waits for the latch. One flip may be pending: a swap that finds one waits for
+ * it, so the buffer it then blits into is never the one being scanned or flipped to. The source surface
+ * may go back to CoreAnimation before the blit has run: its next rendering into it is submitted later on
+ * the same ring, which the GPU executes in order.
+ */
+
+static void
+sweet_async_worker(void *arg __unused, wait_result_t wr __unused)
+{
+	for (;;) {
+		IOLockLock(sweet_async_lock);
+		while (sweet_async_pending < 0) {
+			IOLockSleep(sweet_async_lock, &sweet_async_pending, THREAD_UNINT);
+		}
+		int b = sweet_async_pending;
+		uint32_t seq = sweet_async_seq;
+		IOLockUnlock(sweet_async_lock);
+		int fence = sweet_gpu_wait_ns(seq, 100000000ULL);
+		uint32_t ms = 0;
+		int r = sweet_flip_to(sweet_flip_pa[b], FLIP_STRIDE, &ms);
+		if (sweet_async_logged < 6 || r < 0 || fence) {
+			sweet_async_logged++;
+			printf("SWEET FLIP: async buffer %d: fence %s, %s after %u ms\n", b, fence ? "TIMEOUT" : "ok",
+			    r == 0 ? "latched" : r == 1 ? "latched after CTL_START" : "NOT LATCHED", ms);
+		}
+		IOLockLock(sweet_async_lock);
+		sweet_async_screen = b;
+		sweet_async_pending = -1;
+		IOLockWakeup(sweet_async_lock, &sweet_async_pending, false);
+		IOLockUnlock(sweet_async_lock);
+	}
+}
+
+static void
+sweet_async_init(void)
+{
+	uint32_t on = 0;
+	if (!sweet_gpublit_on || !PE_parse_boot_argn("sweetfb_async", &on, sizeof(on)) || !on) {
+		return;
+	}
+	sweet_async_lock = IOLockAlloc();
+	thread_t t;
+	if (sweet_async_lock == NULL || kernel_thread_start(sweet_async_worker, NULL, &t) != KERN_SUCCESS) {
+		return;
+	}
+	thread_deallocate(t);
+	sweet_async_on = true;
+	printf("SWEET FLIP: non-blocking present on\n");
+}

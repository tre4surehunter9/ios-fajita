+/* SweetFramebuffer.cpp: panel presents and the time their CPU copies took. */
+extern uint64_t sweet_fb_presents, sweet_fb_copy_ns;
+
+static void
+stats_thread(void *arg __unused, wait_result_t wr_ __unused)
+{
+	uint64_t last_submits = 0, last_busy = 0, last_waits = 0, last_wait_ns = 0, last_pres = 0, last_copy = 0;
+	for (;;) {
+		delay(5000000);
+		lck_mtx_lock(&sweet_gpu_lock);
+		for (unsigned i = 0; i < STAT_SLOTS; i++) {
+			stat_account(i);
+		}
+		uint64_t submits = stat_submits, busy = stat_busy_ticks, waits = stat_waits, wait_ns = stat_wait_ns;
+		lck_mtx_unlock(&sweet_gpu_lock);
+		uint64_t pres = sweet_fb_presents, copy = sweet_fb_copy_ns;
+		if (submits == last_submits && pres == last_pres) {
+			continue;
+		}
+		uint64_t busy_ms = (busy - last_busy) / 19200, np = pres - last_pres;
+		printf("SWEET GPU: 5s: %llu submits, GPU busy %llu ms (%llu%%), %llu waits %llu ms, "
+		    "%llu presents (%llu.%llu/s) copy %llu us each%s\n", submits - last_submits, busy_ms, busy_ms / 50,
+		    waits - last_waits, (wait_ns - last_wait_ns) / 1000000, np, np / 5, (np * 2) % 10,
+		    np ? (copy - last_copy) / np / 1000 : 0, gpu_hung ? ", GPU HUNG" : "");
+		last_submits = submits;
+		last_busy = busy;
+		last_waits = waits;
+		last_wait_ns = wait_ns;
+		last_pres = pres;
+		last_copy = copy;
+	}
+}

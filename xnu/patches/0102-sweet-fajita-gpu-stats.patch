@@ -994,6 +997,36 @@ sweet_gpu_unmap(uint64_t iova, uint64_t size)
 #define PC_CCU_INVALIDATE_DEPTH	0x18
 #define PC_CCU_INVALIDATE_COLOR	0x19
 #define MAX_SUBMIT_IBS		16
+#define CP_REG_TO_MEM		0x3e
+#define CP_ALWAYS_ON_COUNTER	0x0980
+#define STAT_SLOTS		64		/* 128 B each: start stamp at +0, end at +64 (IS_64B writes 64 B) */
+
+/*
+ * Phase 4 measurement: the CP stamps CP_ALWAYS_ON_COUNTER (19.2 MHz) before
+ * and after each submission's IBs (as msm's get_stats_counter); a slot's
+ * time counts as GPU busy once its fence has passed (at slot reuse or at
+ * the 5-second report). Waits are counted with the time spent in them.
+ */
+static uint32_t stat_seq[STAT_SLOTS];
+static bool stat_counted[STAT_SLOTS];
+static uint64_t stat_submits, stat_busy_ticks, stat_waits, stat_wait_ns;
+static uint32_t wait_mode = 1;		/* sweetgpuwait=: 0 the old 10 us delay loop, 1 poll 50 us then 200 us sleeps */
+
+static bool fence_reached(uint32_t seq);
+
+static void
+stat_account(unsigned slot)
+{
+	if (stat_seq[slot] == 0 || stat_counted[slot] || !fence_reached(stat_seq[slot])) {
+		return;
+	}
+	vm_offset_t b = PV(P_STATS) + 128 * slot;
+	uint64_t t0 = rd(b) | ((uint64_t)rd(b + 4) << 32), t1 = rd(b + 64) | ((uint64_t)rd(b + 68) << 32);
+	if (t1 > t0 && t1 - t0 < 19200000ULL * 10) {	/* ignore torn or stale stamps */
+		stat_busy_ticks += t1 - t0;
+	}
+	stat_counted[slot] = true;
+}
 

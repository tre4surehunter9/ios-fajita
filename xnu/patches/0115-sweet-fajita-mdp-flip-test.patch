+/*
+ * 0115, read-only, for the display (SweetFramebuffer, ~20 s after start): every valid SMR of the apps SMMU
+ * with its S2CR, flagging the MDSS streams (sdm845.dtsi mdss iommus <&apps_smmu 0x880 0x8>, and 0xc80),
+ * and the context bank of each translating entry. One line every 50 ms (bursts are dropped on the USB
+ * console).
+ */
+void sweet_smmu_report_display(void);
+
+void
+sweet_smmu_report_display(void)
+{
+	vm_offset_t smmu = ml_io_map(SMMU_PA, SMMU_SIZE);
+	if (smmu == 0) {
+		return;
+	}
+	uint32_t scr0 = usb_rd(smmu, 0x0), idr0 = usb_rd(smmu, 0x20), idr1 = usb_rd(smmu, 0x24);
+	unsigned nsmr = idr0 & 0xffu, ncb = idr1 & 0xffu;
+	uint32_t page = (idr1 & (1u << 31)) ? 0x10000u : 0x1000u;
+	uint32_t npage = 1u << (((idr1 >> 28) & 7u) + 1u);
+	printf("SWEET SMMU: sCR0 %#x (CLIENTPD %u USFCFG %u) smr=%u cb=%u\n", scr0, scr0 & 1u, (scr0 >> 10) & 1u,
+	    nsmr, ncb);
+	delay(50000);
+	if (nsmr > 128 || ncb > 128 || (uint64_t)page * npage * 2 > SMMU_SIZE) {
+		return;
+	}
+	for (unsigned i = 0; i < nsmr; i++) {
+		uint32_t smr = usb_rd(smmu, 0x800 + 4 * i);
+		if (!(smr & (1u << 31))) {
+			continue;
+		}
+		uint32_t id = smr & 0x7fffu, mask = (smr >> 16) & 0x7fffu;
+		uint32_t s2cr = usb_rd(smmu, 0xc00 + 4 * i);
+		unsigned type = (s2cr >> 16) & 3u, cb = s2cr & 0xffu;
+		bool mdss = !((0x880u ^ id) & ~mask & 0x7fffu) || !((0xc80u ^ id) & ~mask & 0x7fffu);
+		printf("SWEET SMMU: SMR%u id %#x mask %#x -> S2CR %#x %s cb %u%s\n", i, id, mask, s2cr,
+		    type == 0 ? "translate" : type == 1 ? "bypass" : "fault", cb, mdss ? "  <- MDSS (display)" : "");
+		delay(50000);
+		if (type == 0 && cb < ncb) {
+			vm_offset_t c = smmu + (vm_offset_t)npage * page + (vm_offset_t)cb * page;
+			printf("SWEET SMMU:   CB%u CBAR %#x SCTLR %#x TTBR0 %#x%08x TCR %#x FSR %#x FAR %#x%08x\n",
+			    cb, usb_rd(smmu, page + 4 * cb), usb_rd(c, 0x0), usb_rd(c, 0x24), usb_rd(c, 0x20),
+			    usb_rd(c, 0x30), usb_rd(c, 0x58), usb_rd(c, 0x64), usb_rd(c, 0x60));
+			delay(50000);
+		}
+	}
+}

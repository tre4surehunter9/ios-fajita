+/*
+ * 0115 flip test (sweetfb_flip=1, fajita): scan-out buffers of our own with a 64-byte aligned stride, the
+ * first step of the GPU present path (the A6xx 2D engine writes only 64-byte pitches; the panel's is 4320).
+ * ABL's cont_splash reservation at 0x9d400000 is 36 MiB and a frame takes 10 MB, so two buffers sit in it at
+ * +12 MiB and +24 MiB: memory the display already reads, below 4 GB (SSPP_SRC0_ADDR is 32 bits). Each GPU
+ * frame is copied (CPU, for now) into the back buffer, then VIG0 (the pipe ABL scans with: 0114) gets its
+ * address and stride and CTL0 is flushed (VIG0 = flush bit 0; dpu_hw_ctl.c); with PINGPONG0 auto-refresh the
+ * flush latches at the next frame and the bit clears. If it does not clear in 50 ms, CTL_START is tried; if
+ * that fails too, VIG0 goes back to the splash buffer and the test is off for this boot.
+ */
+#define FLIP_STRIDE		4352u			/* 1088 px */
+#define FLIP_OFFSET		0x00c00000ull		/* 12 MiB */
+#define MDP_VIG0		0x4000u
+#define MDP_CTL0		0x1000u
+
+static bool sweet_flip_on;
+static uintptr_t sweet_flip_va[2];
+static uint64_t sweet_flip_pa[2];
+static unsigned sweet_flip_next, sweet_flip_logged;
+
+static void
+sweet_flip_init(uint64_t splash, uint32_t height)
+{
+	uint32_t on = 0;
+	vm_offset_t mdp;
+	if (!PE_parse_boot_argn("sweetfb_flip", &on, sizeof(on)) || !on || (mdp = sweet_mdp_map()) == 0) {
+		return;
+	}
+	uint32_t addr = *(volatile uint32_t *)(mdp + MDP_VIG0 + 0x14);
+	if (addr != (uint32_t)splash) {
+		printf("SWEET FLIP: VIG0 scans 0x%x, not the splash buffer 0x%llx; flip test off\n", addr, splash);
+		return;
+	}
+	vm_size_t size = round_page((vm_size_t)FLIP_STRIDE * height);
+	for (unsigned i = 0; i < 2; i++) {
+		sweet_flip_pa[i] = splash + FLIP_OFFSET * (i + 1);
+		sweet_flip_va[i] = ml_io_map_unmappable((vm_offset_t)sweet_flip_pa[i], size, 0x6 /* WCOMB */);
+		if (sweet_flip_va[i] == 0) {
+			printf("SWEET FLIP: mapping 0x%llx failed; flip test off\n", sweet_flip_pa[i]);
+			return;
+		}
+		bzero((void *)sweet_flip_va[i], size);
+	}
+	sweet_flip_on = true;
+	printf("SWEET FLIP: on, buffers 0x%llx 0x%llx, stride %u\n", sweet_flip_pa[0], sweet_flip_pa[1], FLIP_STRIDE);
+}
+
+/* VIG0 to (pa, stride); 0 latched on the flush, 1 latched after CTL_START, -1 not latched. */
+static int
+sweet_flip_to(uint64_t pa, uint32_t stride, uint32_t *waited_ms)
+{
+	vm_offset_t mdp = sweet_mdp;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(mdp + MDP_VIG0 + 0x14) = (uint32_t)pa;
+	*(volatile uint32_t *)(mdp + MDP_VIG0 + 0x24) = stride;
+	*(volatile uint32_t *)(mdp + MDP_CTL0 + 0x18) = 1u;
+	uint32_t ms = 0;
+	for (; ms < 50 && (*(volatile uint32_t *)(mdp + MDP_CTL0 + 0x18) & 1u); ms++) {
+		IOSleep(1);
+	}
+	if (!(*(volatile uint32_t *)(mdp + MDP_CTL0 + 0x18) & 1u)) {
+		*waited_ms = ms;
+		return 0;
+	}
+	*(volatile uint32_t *)(mdp + MDP_CTL0 + 0x1c) = 1u;		/* CTL_START */
+	for (; ms < 100 && (*(volatile uint32_t *)(mdp + MDP_CTL0 + 0x18) & 1u); ms++) {
+		IOSleep(1);
+	}
+	*waited_ms = ms;
+	return (*(volatile uint32_t *)(mdp + MDP_CTL0 + 0x18) & 1u) ? -1 : 1;
 }
 

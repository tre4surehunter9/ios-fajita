+int
+sweet_gpu_map_pages(uint64_t iova, const uint64_t *pages, uint32_t n)
+{
+	if ((iova & 0xfff) || iova + 0x1000ULL * n > (1ULL << 39)) {
+		return -1;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		if (pages[i] & 0xfff) {
+			return -1;
+		}
+	}
+	lck_mtx_lock(&sweet_gpu_lock);
+	int rc = map_4k_list(iova, 0, pages, 0x1000ULL * n, false);
+	lck_mtx_unlock(&sweet_gpu_lock);
+	return rc;
+}
+
+/* One 4 GiB GPU address window per client connection, from 8 GiB up (inside 39 bits). */
+#define WINDOW_BASE		0x200000000ULL
+#define WINDOW_SIZE		0x100000000ULL
+#define WINDOWS			64
+static uint64_t window_used;
+
+int
+sweet_gpu_window_alloc(uint64_t *base, uint64_t *size)
+{
+	lck_mtx_lock(&sweet_gpu_lock);
+	for (unsigned i = 0; i < WINDOWS; i++) {
+		if (!(window_used & (1ULL << i))) {
+			window_used |= 1ULL << i;
+			lck_mtx_unlock(&sweet_gpu_lock);
+			*base = WINDOW_BASE + WINDOW_SIZE * i;
+			*size = WINDOW_SIZE;
+			return 0;
+		}
+	}
+	lck_mtx_unlock(&sweet_gpu_lock);
+	return -1;
+}
+
+void
+sweet_gpu_window_free(uint64_t base)
+{
+	if (base < WINDOW_BASE || base >= WINDOW_BASE + WINDOW_SIZE * WINDOWS) {
+		return;
+	}
+	lck_mtx_lock(&sweet_gpu_lock);
+	window_used &= ~(1ULL << ((base - WINDOW_BASE) / WINDOW_SIZE));
+	lck_mtx_unlock(&sweet_gpu_lock);
+}
+
+/* The GMU's always-on counter (19.2 MHz), as Turnip's timestamp source. */
+uint64_t
+sweet_gpu_timestamp(void)
+{
+	uint32_t hi, lo;
+	do {
+		hi = rd(G(GMU_AO_COUNTER_L + 4));
+		lo = rd(G(GMU_AO_COUNTER_L));
+	} while (hi != rd(G(GMU_AO_COUNTER_L + 4)));
+	return ((uint64_t)hi << 32) | lo;
+}
+
+uint64_t
+sweet_gpu_faults(void)
+{
+	return gpu_hung ? 1 : 0;
+}

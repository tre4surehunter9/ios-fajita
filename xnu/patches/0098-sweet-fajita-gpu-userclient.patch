+/* ---- user client ---- */
+
+class SweetGPUUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(SweetGPUUserClient);
+
+	task_t fTask;
+	IOLock *fLock;
+	uint64_t fWinBase, fWinSize;    /* this connection's GPU addresses */
+	SweetGPUBO *fBO;
+	uint32_t fBOCap;
+	uint64_t *fPageBuf;
+	uint32_t fLastFence;            /* waited for before this client's memory goes */
+
+	SweetGPUBO *find(uint64_t handle);
+	IOReturn newSlot(IOMemoryDescriptor *md, uint64_t bytes, bool imported, uint64_t *handle);
+	void release(SweetGPUBO *bo);
+	IOReturn method(uint32_t method, const void *in, uint32_t inSize, void *out, uint32_t *outSize);
+
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	IOReturn clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetGPUUserClient, IOUserClient);
+
+bool
+SweetGPUUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	fLock = IOLockAlloc();
+	fBOCap = 256;
+	fBO = IONewZero(SweetGPUBO, fBOCap);
+	fPageBuf = IONew(uint64_t, SWEET_GPU_PAGEBUF);
+	if (fLock == NULL || fBO == NULL || fPageBuf == NULL) {
+		return false;
+	}
+	if (!sweet_gpu_is_ready() || sweet_gpu_window_alloc(&fWinBase, &fWinSize)) {
+		IOLog("SWEET GPU: client refused (%s)\n", sweet_gpu_is_ready() ? "no GPU window left" : "GPU not ready");
+		return false;
+	}
+	IOLog("SWEET GPU: client opened (type 0x%x), window 0x%llx-0x%llx\n", (unsigned)type, fWinBase,
+	    fWinBase + fWinSize);
+	return true;
+}
+
+IOReturn
+SweetGPUUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+void
+SweetGPUUserClient::free(void)
+{
+	/* Unmapping or reusing memory the GPU may still use would fault or corrupt: wait for the last fence. */
+	if (fLastFence != 0 && sweet_gpu_wait_ns(fLastFence, 2000000000ULL)) {
+		IOLog("SWEET GPU: client freed with fence %u still pending\n", fLastFence);
+	}
+	if (fBO != NULL) {
+		for (uint32_t i = 0; i < fBOCap; i++) {
+			release(&fBO[i]);
+		}
+		IODelete(fBO, SweetGPUBO, fBOCap);
+		fBO = NULL;
+	}
+	if (fPageBuf != NULL) {
+		IODelete(fPageBuf, uint64_t, SWEET_GPU_PAGEBUF);
+		fPageBuf = NULL;
+	}
+	if (fWinSize != 0) {
+		sweet_gpu_window_free(fWinBase);
+		fWinSize = 0;
+	}
+	if (fLock != NULL) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	IOUserClient::free();
+}
+
+SweetGPUBO *
+SweetGPUUserClient::find(uint64_t handle)
+{
+	return handle >= 1 && handle <= fBOCap && fBO[handle - 1].md != NULL ? &fBO[handle - 1] : NULL;
+}
+
+/* With fLock held: the first free slot (the table doubles when full). */
+IOReturn
+SweetGPUUserClient::newSlot(IOMemoryDescriptor *md, uint64_t bytes, bool imported, uint64_t *handle)
+{
+	uint32_t i = 0;
+	while (i < fBOCap && fBO[i].md != NULL) {
+		i++;
+	}
+	if (i == fBOCap) {
+		if (fBOCap >= SWEET_GPU_MAX_BOS) {
+			return kIOReturnNoResources;
+		}
+		SweetGPUBO *n = IONewZero(SweetGPUBO, fBOCap * 2);
+		if (n == NULL) {
+			return kIOReturnNoMemory;
+		}
+		memcpy(n, fBO, sizeof(*n) * fBOCap);
+		IODelete(fBO, SweetGPUBO, fBOCap);
+		fBO = n;
+		fBOCap *= 2;
+	}
+	bzero(&fBO[i], sizeof(fBO[i]));
+	fBO[i].md = md;
+	fBO[i].bytes = bytes;
+	fBO[i].imported = imported;
+	*handle = i + 1;
+	return kIOReturnSuccess;
+}
+
+/* Unmap from the GPU, unwire, drop (arena memory: once no task maps it any more). */
+void
+SweetGPUUserClient::release(SweetGPUBO *bo)
+{
+	if (bo->md == NULL) {
+		return;
+	}
+	if (bo->iova != 0) {
+		sweet_gpu_unmap(bo->iova, bo->bytes);
+	}
+	if (bo->imported) {
+		bo->md->complete();
+		bo->md->release();
+	} else {
+		sweet_arena_release(bo->md, bo->pa, bo->alloc);
+	}
+	bzero(bo, sizeof(*bo));
+}
+
+IOReturn
+SweetGPUUserClient::clientMemoryForType(UInt32 type, IOOptionBits *options, IOMemoryDescriptor **memory)
+{
+	/* token = handle; write-combining, as the GPU maps it non-cacheable (imports keep the client's mapping) */
+	IOLockLock(fLock);
+	SweetGPUBO *bo = find(type);
+	IOMemoryDescriptor *md = bo != NULL && !bo->imported ? bo->md : NULL;
+	if (md != NULL) {
+		md->retain();
+	}
+	IOLockUnlock(fLock);
+	if (md == NULL) {
+		return kIOReturnBadArgument;
+	}
+	*options = (*options & ~kIOMapCacheMask) | kIOMapWriteCombineCache;
+	*memory = md;
+	return kIOReturnSuccess;
+}
+
+IOReturn
+SweetGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *dispatch __unused, OSObject *target __unused, void *reference __unused)
+{
+	const uint32_t *w = (const uint32_t *)args->structureInput;
+	uint32_t isz = args->structureInput != NULL ? args->structureInputSize : 0;
+	void *o = args->structureOutputDescriptor == NULL ? args->structureOutput : NULL;
+	uint32_t osz = o != NULL ? args->structureOutputSize : 0;
+	IOReturn r;
+	if (isz >= 8 && w[0] == SWEET_GPU_TUNNEL) {
+		r = w[1] == 0xffffffffu ? kIOReturnSuccess : method(w[1], w + 2, isz - 8, o, &osz);
+	} else {
+		r = method(selector, isz ? args->structureInput : NULL, isz, o, &osz);
+	}
+	if (o != NULL) {
+		args->structureOutputSize = r == kIOReturnSuccess ? osz : 0;
+	}
+	return r;
+}
+
+IOReturn
+SweetGPUUserClient::method(uint32_t m, const void *in, uint32_t inSize, void *out, uint32_t *outSize)
+{
+	static uint32_t logged;
+#define M_IN(T)         if (in == NULL || inSize != sizeof(T)) return kIOReturnBadArgument; const T *rq = (const T *)in
+#define M_OUT(T)        if (out == NULL || *outSize < sizeof(T)) return kIOReturnBadArgument; T *rp = (T *)out; \
+	                bzero(rp, sizeof(T)); *outSize = sizeof(T)
+	if (m < 32 && !(logged & (1u << m))) {
+		logged |= 1u << m;
+		IOLog("SWEET GPU: method %u first used (in %u)\n", m, inSize);
+	}
+	switch (m) {
+	case NativeAdrenoMethodQuery: {
+		M_OUT(NativeAdrenoAbiParams);
+		rp->abi_version = NativeAdrenoAbiVersion;
+		rp->input_bits = 39;                    /* CB1: T0SZ 25 */
+		rp->output_bits = 36;                   /* CB1: TCR2 PASize 1 */
+		rp->flags = NativeAdrenoParamsHostImport;
+		rp->max_bo_bytes = 1ULL << NativeAdrenoAbiMaxBoBytesShift;
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodGetDeviceInfo: {
+		M_OUT(NativeAdrenoAbiDeviceInfo);
+		/*
+		 * What sweet_a630.c's hw_init programs and mainline's a630 catalog
+		 * says: chip id 0x06030001 (adreno_is_a630), GMEM 1 MiB at UCHE
+		 * 0x100000, trap base 0x1fffffffff000. UBWC is not configured yet
+		 * (no a6xx_set_ubwc_config): Turnip falls back to its own a630 UBWC
+		 * defaults until it is (version 0 = unknown).
+		 */
+		rp->chip_id = 0x06030001;
+		rp->gmem_bytes = 0x100000;
+		rp->gmem_base = 0x100000;
+		rp->uche_trap_base = 0x1fffffffff000ULL;
+		rp->va_start = fWinBase;
+		rp->va_size = fWinSize;
+		rp->highest_bank_bit = 15;
+		rp->ubwc_swizzle = 0x6;
+		rp->macrotile_mode = 0;
+		rp->ubwc_version = 0;
+		rp->flags = NativeAdrenoDeviceClientIova;
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodBoAlloc: {
+		M_IN(NativeAdrenoAbiBoAlloc);
+		M_OUT(NativeAdrenoAbiBoAllocReply);
+		if (rq->bytes == 0 || (rq->bytes & 4095) || rq->bytes > (1ULL << NativeAdrenoAbiMaxBoBytesShift) ||
+		    rq->align_log2 < 12 || rq->align_log2 > 24 || rq->contiguous > 1) {
+			return kIOReturnBadArgument;
+		}
+		sweet_zombie_sweep();
+		/* 16 KiB VM pages: the CPU mapping covers whole pages, so does the allocation. */
+		uint64_t len = round_page_64(rq->bytes), pa = 0;
+		if (sweet_gpu_bo_alloc(len, 1ULL << rq->align_log2, &pa, NULL)) {
+			return kIOReturnNoMemory;
+		}
+		uint64_t alloc = (len + 0xffff) & ~0xffffULL;
+		IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(pa, len, kIODirectionInOut);
+		if (md == NULL) {
+			sweet_gpu_bo_free(pa, alloc);
+			return kIOReturnNoMemory;
+		}
+		IOLockLock(fLock);
+		uint64_t h = 0;
+		IOReturn r = newSlot(md, rq->bytes, false, &h);
+		if (r == kIOReturnSuccess) {
+			fBO[h - 1].pa = pa;
+			fBO[h - 1].alloc = alloc;
+		}
+		IOLockUnlock(fLock);
+		if (r != kIOReturnSuccess) {
+			md->release();
+			sweet_gpu_bo_free(pa, alloc);
+			return r;
+		}
+		rp->handle = h;
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodBoImport: {
+		M_IN(NativeAdrenoAbiBoImport);
+		M_OUT(NativeAdrenoAbiBoAllocReply);
+		if (rq->address == 0 || ((rq->address | rq->bytes) & 4095) || rq->bytes == 0 ||
+		    rq->bytes > (1ULL << NativeAdrenoAbiMaxBoBytesShift)) {
+			return kIOReturnBadArgument;
+		}
+		IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange(rq->address, rq->bytes, kIODirectionInOut,
+		    fTask);
+		if (md != NULL && md->prepare() != kIOReturnSuccess) {
+			md->release();  /* read-only pages: pin them for reading */
+			md = IOMemoryDescriptor::withAddressRange(rq->address, rq->bytes, kIODirectionOut, fTask);
+			if (md != NULL && md->prepare() != kIOReturnSuccess) {
+				md->release();
+				md = NULL;
+			}
+		}
+		if (md == NULL) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(fLock);
+		uint64_t h = 0;
+		IOReturn r = newSlot(md, rq->bytes, true, &h);
+		IOLockUnlock(fLock);
+		if (r != kIOReturnSuccess) {
+			md->complete();
+			md->release();
+			return r;
+		}
+		rp->handle = h;
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodBoMap: {
+		M_IN(NativeAdrenoAbiBoMap);
+		M_OUT(NativeAdrenoAbiBoMapReply);
+		if (!(rq->permissions & 1) || (rq->permissions & ~3u) || (rq->iova & 4095) || rq->reserved) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(fLock);
+		SweetGPUBO *bo = find(rq->handle);
+		IOReturn r = kIOReturnSuccess;
+		if (bo == NULL) {
+			r = kIOReturnBadArgument;
+		} else if (bo->iova != 0) {
+			r = kIOReturnBusy;
+		} else if (rq->iova < fWinBase || rq->iova + bo->bytes > fWinBase + fWinSize || rq->iova + bo->bytes < rq->iova) {
+			r = kIOReturnBadArgument;
+		}
+		/* the pages in 4 KiB steps (16 KiB VM pages, any 4 KiB-aligned import), mapped in pieces */
+		for (uint64_t off = 0; r == kIOReturnSuccess && off < bo->bytes;) {
+			uint32_t n = 0;
+			uint64_t start = off;
+			for (; n < SWEET_GPU_PAGEBUF && off < bo->bytes; n++, off += 4096) {
+				IOByteCount seg = 0;
+				addr64_t pa = bo->md->getPhysicalSegment(off, &seg, kIOMemoryMapperNone);
+				if (pa == 0 || (pa & 4095)) {
+					r = kIOReturnVMError;
+					break;
+				}
+				fPageBuf[n] = pa;
+			}
+			if (r == kIOReturnSuccess && sweet_gpu_map_pages(rq->iova + start, fPageBuf, n)) {
+				r = kIOReturnNoResources;
+			}
+		}
+		if (r == kIOReturnSuccess) {
+			bo->iova = rq->iova;
+			rp->iova = rq->iova;
+		} else if (bo != NULL && bo->iova == 0 && r != kIOReturnBadArgument && r != kIOReturnBusy) {
+			sweet_gpu_unmap(rq->iova, bo->bytes);
+		}
+		IOLockUnlock(fLock);
+		return r;
+	}
+	case NativeAdrenoMethodBoFree: {
+		M_IN(NativeAdrenoAbiBoFree);
+		IOLockLock(fLock);
+		SweetGPUBO *bo = find(rq->handle);
+		if (bo != NULL) {
+			release(bo);
+		}
+		IOLockUnlock(fLock);
+		return bo != NULL ? kIOReturnSuccess : kIOReturnBadArgument;
+	}
+	case NativeAdrenoMethodBoCpuMap: {
+		M_IN(NativeAdrenoAbiBoCpuMap);
+		M_OUT(NativeAdrenoAbiBoCpuMapReply);
+		IOLockLock(fLock);
+		SweetGPUBO *bo = find(rq->handle);
+		IOReturn r = bo == NULL || bo->imported ? kIOReturnBadArgument : kIOReturnSuccess;
+		if (r == kIOReturnSuccess) {
+			rp->token = (uint32_t)rq->handle;       /* the clientMemoryForType type */
+			rp->bytes = bo->md->getLength();
+		}
+		IOLockUnlock(fLock);
+		return r;
+	}
+	case NativeAdrenoMethodBoCpuUnmap:
+		return kIOReturnSuccess;        /* the mapping is the client's (IOConnectUnmapMemory64) */
+	case NativeAdrenoMethodSubmit: {
+		M_IN(NativeAdrenoAbiSubmit);
+		M_OUT(NativeAdrenoAbiSubmitReply);
+		if (rq->buffer_count == 0 || rq->buffer_count > NativeAdrenoAbiMaxBuffers || rq->reserved) {
+			return kIOReturnBadArgument;
+		}
+		uint64_t iova[NativeAdrenoAbiMaxBuffers];
+		uint32_t dw[NativeAdrenoAbiMaxBuffers];
+		for (uint32_t i = 0; i < rq->buffer_count; i++) {
+			const NativeAdrenoAbiSubmitBuffer *b = &rq->buffers[i];
+			if ((b->bytes & 3) || b->bytes == 0 || b->bytes / 4 > 0xfffff || b->iova < fWinBase ||
+			    b->iova + b->bytes > fWinBase + fWinSize) {
+				return kIOReturnBadArgument;
+			}
+			iova[i] = b->iova;
+			dw[i] = (uint32_t)(b->bytes / 4);
+		}
+		if (rq->wait_fence != 0 && sweet_gpu_wait_ns((uint32_t)rq->wait_fence, rq->wait_timeout_ns)) {
+			return kIOReturnTimeout;
+		}
+		uint32_t fence = 0;
+		bool busy = false;
+		if (sweet_gpu_submit_ibs(iova, dw, rq->buffer_count, &fence, &busy)) {
+			return busy ? kIOReturnBusy : kIOReturnNotReady;
+		}
+		fLastFence = fence;
+		rp->fence = fence;
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodWaitFence: {
+		M_IN(NativeAdrenoAbiWaitFence);
+		return sweet_gpu_wait_ns((uint32_t)rq->fence, rq->timeout_ns) ? kIOReturnTimeout : kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodGetTimestamp: {
+		M_OUT(NativeAdrenoAbiTimestamp);
+		rp->ticks = sweet_gpu_timestamp();
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodGetStatus: {
+		M_OUT(NativeAdrenoAbiStatus);
+		rp->faults = sweet_gpu_faults();
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodSetMetadata:
+		return kIOReturnSuccess;        /* only for dma-buf exports, which Darwin has not */
+	case NativeAdrenoMethodGetMetadata: {
+		M_OUT(NativeAdrenoAbiMetadata);
+		return kIOReturnSuccess;        /* bytes 0 */
+	}
+	case NativeAdrenoMethodCreateQueue: {
+		M_OUT(NativeAdrenoAbiQueueReply);
+		rp->queue = 1;                  /* one ring: every queue is it */
+		return kIOReturnSuccess;
+	}
+	case NativeAdrenoMethodCloseQueue:
+		return kIOReturnSuccess;
+	default:
+		return kIOReturnUnsupported;
+	}
+#undef M_IN
+#undef M_OUT
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/iokit/Kernel/arm/SweetGPUABI.h b/iokit/Kernel/arm/SweetGPUABI.h
new file mode 100644
index 0000000..268e960
--- /dev/null
+++ b/iokit/Kernel/arm/SweetGPUABI.h
@@ -0,0 +1,170 @@
+/*
+ * NativeAdreno ABI v1, unchanged from UniXNU's NativeAdreno (MIT) as carried by ios-flame
+ * (phone/turnip/NativeAdrenoABI.h): the wire format Turnip's darwin kernel backend
+ * speaks to iokit/Kernel/arm/SweetGPU.cpp.
+ */
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_ABI_H
+#define NATIVE_ADRENO_ABI_H
+#include <stdint.h>
+
+/* Versioned kernel/user-client wire ABI for the native Adreno driver. This is
+ * NOT the Metal, IOKit or Turnip ABI and it does not describe an ioctl. The
+ * IOKit service will copy exactly these fixed-size records across its external
+ * methods. All fields are little endian; both participants are ARM64. Every
+ * array is inside one fixed record so a caller cannot pass a length that
+ * disagrees with the storage. Unknown versions, methods and flags are refused
+ * rather than ignored. */
+enum {
+    NativeAdrenoAbiVersion = 1,
+    NativeAdrenoAbiMaxBuffers = 16,
+    NativeAdrenoAbiMaxBoBytesShift = 28, /* 256MiB per object */
+    NativeAdrenoMethodQuery = 1,
+    NativeAdrenoMethodBoAlloc = 2,
+    NativeAdrenoMethodBoMap = 3,
+    NativeAdrenoMethodBoFree = 4,
+    NativeAdrenoMethodSubmit = 5,
+    NativeAdrenoMethodWaitFence = 6,
+    NativeAdrenoMethodGetTimestamp = 7,
+    NativeAdrenoMethodGetStatus = 8,
+    NativeAdrenoMethodSetMetadata = 9,
+    NativeAdrenoMethodGetMetadata = 10,
+    NativeAdrenoMethodCreateQueue = 11,
+    NativeAdrenoMethodCloseQueue = 12,
+    NativeAdrenoMethodBoCpuMap = 13,
+    NativeAdrenoMethodBoCpuUnmap = 14,
+    NativeAdrenoMethodGetDeviceInfo = 15,
+    NativeAdrenoMethodBoImport = 16,
+    NativeAdrenoAbiMetadataBytes = 64,
+    NativeAdrenoAbiMaxQueues = 8
+};
+struct NativeAdrenoAbiParams {
+    uint32_t abi_version;
+    uint32_t input_bits;          /* GPU VA bits below 2^input_bits */
+    uint32_t output_bits;         /* physical address bits */
+    uint32_t flags;               /* NativeAdrenoParamsHostImport or zero */
+    uint64_t max_bo_bytes;
+};
+enum {
+    NativeAdrenoParamsHostImport = 1  /* BoImport pins the caller's own pages (an IOSurface's) as a BO */
+};
+struct NativeAdrenoAbiBoAlloc {
+    uint64_t bytes;               /* 4KiB multiple, <= max_bo_bytes */
+    uint32_t align_log2;          /* 12..24 */
+    uint32_t contiguous;          /* 1 requires one raw physical span */
+};
+struct NativeAdrenoAbiBoAllocReply {
+    uint64_t handle;              /* opaque to userspace, nonzero */
+};
+/* Pins [address, address + bytes) of the CALLING task and makes it a BO (reply: NativeAdrenoAbiBoAllocReply). The pages stay wired
+ * until BoFree; they keep the caller's own CPU mapping and cache mode, so the caller cleans its caches before GPU use and invalidates
+ * them after GPU writes (the GPU maps them non-cacheable). An imported BO has no CPU-map token. */
+struct NativeAdrenoAbiBoImport {
+    uint64_t address;             /* 4KiB aligned */
+    uint64_t bytes;               /* 4KiB multiple, <= max_bo_bytes */
+};
+struct NativeAdrenoAbiBoMap {
+    uint64_t handle;
+    uint64_t iova;                /* 4KiB aligned, inside the mounted aperture */
+    uint32_t permissions;         /* bit0 read, bit1 write; read required */
+    uint32_t writeback;           /* 0 normal non-coherent, 1 WB/WA */
+    uint32_t shareability;        /* 2 outer, 3 inner */
+    uint32_t reserved;            /* zero */
+};
+struct NativeAdrenoAbiBoMapReply {
+    uint64_t iova;
+};
+struct NativeAdrenoAbiBoFree {
+    uint64_t handle;
+};
+struct NativeAdrenoAbiSubmitBuffer {
+    uint64_t handle;
+    uint64_t iova;
+    uint64_t bytes;               /* 4-byte multiple, dword count = bytes/4 */
+};
+struct NativeAdrenoAbiSubmit {
+    uint32_t buffer_count;        /* 1..NativeAdrenoAbiMaxBuffers */
+    uint32_t reserved;            /* zero */
+    uint64_t queue;               /* open queue; 0 is created by open() */
+    uint64_t wait_fence;          /* zero or an earlier fence of this client */
+    uint64_t wait_timeout_ns;     /* used only when wait_fence is nonzero */
+    NativeAdrenoAbiSubmitBuffer buffers[NativeAdrenoAbiMaxBuffers];
+};
+struct NativeAdrenoAbiMetadata {
+    uint64_t handle;              /* object identity */
+    uint32_t bytes;               /* set: length; get: requested capacity */
+    uint32_t reserved;            /* zero */
+    char text[NativeAdrenoAbiMetadataBytes]; /* raw bytes, not NUL terminated */
+};
+struct NativeAdrenoAbiSubmitReply {
+    uint64_t fence;               /* nonzero CP timestamp value */
+};
+struct NativeAdrenoAbiWaitFence {
+    uint64_t fence;
+    uint64_t timeout_ns;          /* 0 polls once */
+};
+struct NativeAdrenoAbiTimestamp {
+    uint64_t ticks;               /* GPU always-on counter value */
+};
+struct NativeAdrenoAbiBoCpuMap {
+    uint64_t handle;
+};
+struct NativeAdrenoAbiBoCpuMapReply {
+    uint32_t token;               /* clientMemoryForType selector */
+    uint32_t reserved;            /* zero */
+    uint64_t bytes;               /* bytes the mapping covers */
+};
+struct NativeAdrenoAbiBoCpuUnmap {
+    uint64_t handle;
+    uint32_t token;               /* exactly the token returned by map */
+    uint32_t reserved;            /* zero */
+};
+struct NativeAdrenoAbiQueue {
+    uint64_t queue;               /* zero for create, an open id for close */
+};
+struct NativeAdrenoAbiQueueReply {
+    uint64_t queue;               /* nonzero id of the created queue */
+};
+struct NativeAdrenoAbiStatus {
+    uint64_t faults;              /* monotonic; change means context lost */
+    uint64_t suspends;            /* monotonic suspend/reset count */
+};
+/* Fixed facts of the mounted GPU that the Vulkan driver needs and cannot derive: all come from the board code, which takes
+ * them from the pinned sources (a6xx catalog, UBWC config, the programmed UCHE ranges), never from a guess. */
+enum {
+    NativeAdrenoDeviceClientIova = 1,     /* flags: the client chooses BO addresses (BoMap iova) */
+    NativeAdrenoDeviceCachedCoherent = 2  /* flags: unused until IO-coherent BO memory exists */
+};
+struct NativeAdrenoAbiDeviceInfo {
+    uint32_t chip_id;             /* ADRENO_CHIPID, e.g. 0x43050a01 */
+    uint32_t gmem_bytes;
+    uint64_t gmem_base;           /* UCHE GMEM window start (GPU address) */
+    uint64_t uche_trap_base;
+    uint64_t va_start;            /* first GPU address the client may map */
+    uint64_t va_size;
+    uint32_t highest_bank_bit;
+    uint32_t ubwc_swizzle;        /* bit0 level 1, bit1 level 2, bit2 level 3 */
+    uint32_t macrotile_mode;      /* 0 four channel, 1 eight channel */
+    uint32_t ubwc_version;        /* encoder version, 4 for UBWC 4.0 */
+    uint32_t flags;
+    uint32_t reserved;            /* zero */

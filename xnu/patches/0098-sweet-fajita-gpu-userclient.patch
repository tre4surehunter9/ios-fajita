+/*
+ * SWEET: fajita Adreno 630 for userland (GPU-PLAN.md Phase 2.2).
+ *
+ * SweetGPU is published on IOResources when sweetgpu>=3 on fajita; its user
+ * client speaks the NativeAdreno ABI v1 (SweetGPUABI.h), the wire format of
+ * Turnip's darwin kernel backend: struct methods, either selector = method
+ * or tunnelled as {'NTNL', method, payload} through any selector. Any open
+ * type is accepted. Structure after ios-flame's SweetAccelerator v2 client
+ * (MIT), on top of bsd/dev/sweet_a630.c:
+ *
+ *  - Each connection gets its own 4 GiB GPU address window; the client
+ *    chooses buffer addresses inside it (NativeAdrenoDeviceClientIova).
+ *  - BoAlloc memory comes from the GPU arena in the low DDR bank, never
+ *    from XNU's page allocator (on this kernel lineage it can hand out pages
+ *    below gPhysBase, edi194's console80). It is described with
+ *    withPhysicalAddress and mapped write-combining for the CPU
+ *    (clientMemoryForType, token = handle) and non-cacheable for the GPU.
+ *  - BoImport pins the caller's own pages (IOSurfaces); the caller keeps
+ *    their CPU caches clean itself.
+ *  - Submit: up to 16 IBs inside the client's window, one CACHE_FLUSH_TS
+ *    fence (sweet_gpu_submit_ibs). There is one ring; every queue is it.
+ *
+ * Not a Metal device: Metal looks for IOAcceleratorES, which this is not,
+ * so Core Animation keeps its software path until Phase 3.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <pexpert/pexpert.h>
+#include "SweetGPUABI.h"
+
+extern "C" {
+bool sweet_board_is(const char *want);
+bool sweet_gpu_is_ready(void);
+int sweet_gpu_bo_alloc(uint64_t size, uint64_t align, uint64_t *pa, vm_offset_t *kva);
+void sweet_gpu_bo_free(uint64_t pa, uint64_t size);
+void sweet_gpu_unmap(uint64_t iova, uint64_t size);
+int sweet_gpu_window_alloc(uint64_t *base, uint64_t *size);
+void sweet_gpu_window_free(uint64_t base);
+int sweet_gpu_map_pages(uint64_t iova, const uint64_t *pages, uint32_t n);
+int sweet_gpu_submit_ibs(const uint64_t *iova, const uint32_t *dwords, unsigned n, uint32_t *seq, bool *busy);
+int sweet_gpu_wait_ns(uint32_t seq, uint64_t timeout_ns);
+uint64_t sweet_gpu_timestamp(void);
+uint64_t sweet_gpu_faults(void);
+}
+
+#define SWEET_GPU_TUNNEL        0x4e544e4cu     /* 'NTNL' */
+#define SWEET_GPU_MAX_BOS       65536
+#define SWEET_GPU_PAGEBUF       1024            /* 4 KiB pages per sweet_gpu_map_pages call */
+
+/* One buffer object: slot + 1 = handle = CPU-map token. */
+struct SweetGPUBO {
+	IOMemoryDescriptor *md;         /* NULL: free slot */
+	uint64_t bytes;                 /* 4 KiB multiple, as asked */
+	uint64_t alloc;                 /* arena bytes behind it (allocated BOs) */
+	uint64_t iova;                  /* GPU address while mapped, else 0 */
+	uint64_t pa;                    /* allocated: its arena memory */
+	bool imported;                  /* the client's own pages: no CPU-map token */
+};
+
+class SweetGPU : public IOService {
+	OSDeclareDefaultStructors(SweetGPU);
+
+public:
+	IOService *probe(IOService *provider, SInt32 *score) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetGPU, IOService);
+
+IOService *
+SweetGPU::probe(IOService *provider, SInt32 *score)
+{
+	uint32_t level = 0;
+	PE_parse_boot_argn("sweetgpu", &level, sizeof(level));
+	return level >= 3 && sweet_board_is("oneplus,fajita") ? IOService::probe(provider, score) : NULL;
+}
+
+bool
+SweetGPU::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty("model", "Adreno 630");
+	setProperty(kIOUserClientClassKey, "SweetGPUUserClient");
+	registerService();
+	IOLog("SWEET GPU: SweetGPU published (NativeAdreno ABI v%u)\n", (unsigned)NativeAdrenoAbiVersion);
+	return true;
+}
+
+/* ---- arena memory still mapped into some task ---- */
+
+/*
+ * A BO freed (or a client gone) while a task still maps it: its descriptor
+ * waits here until IOKit has dropped every mapping (retain count back to
+ * ours), then the memory goes back to the arena. Swept on every BoAlloc.
+ * As ios-flame's sweet_zombie_sweep.
+ */
+static IOLock *sweet_zombie_lock;
+static OSArray *sweet_zombies;          /* OSData {IOMemoryDescriptor *, pa, alloc} */
+
+struct sweet_zombie {
+	IOMemoryDescriptor *md;
+	uint64_t pa, alloc;
+};
+
+static void
+sweet_zombie_sweep(void)
+{
+	if (sweet_zombie_lock == NULL) {
+		return;
+	}
+	IOLockLock(sweet_zombie_lock);
+	for (unsigned i = 0; sweet_zombies != NULL && i < sweet_zombies->getCount();) {
+		OSData *d = OSDynamicCast(OSData, sweet_zombies->getObject(i));
+		const struct sweet_zombie *z = d != NULL ? (const struct sweet_zombie *)d->getBytesNoCopy() : NULL;
+		if (z != NULL && z->md->getRetainCount() <= 1) {
+			uint64_t pa = z->pa, alloc = z->alloc;
+			z->md->release();
+			sweet_gpu_bo_free(pa, alloc);
+			sweet_zombies->removeObject(i);
+			continue;
+		}
+		i++;
+	}
+	IOLockUnlock(sweet_zombie_lock);
+}
+
+static void
+sweet_arena_release(IOMemoryDescriptor *md, uint64_t pa, uint64_t alloc)
+{
+	if (md->getRetainCount() <= 1) {
+		md->release();
+		sweet_gpu_bo_free(pa, alloc);
+		return;
+	}
+	if (sweet_zombie_lock == NULL) {
+		IOLock *l = IOLockAlloc();
+		if (!OSCompareAndSwapPtr(NULL, l, &sweet_zombie_lock)) {
+			IOLockFree(l);
+		}
+	}
+	IOLockLock(sweet_zombie_lock);
+	if (sweet_zombies == NULL) {
+		sweet_zombies = OSArray::withCapacity(16);
+	}
+	struct sweet_zombie z = { md, pa, alloc };
+	OSData *d = OSData::withBytes(&z, sizeof(z));
+	if (sweet_zombies != NULL && d != NULL) {
+		sweet_zombies->setObject(d);
+	}
+	OSSafeReleaseNULL(d);
+	IOLockUnlock(sweet_zombie_lock);
+}

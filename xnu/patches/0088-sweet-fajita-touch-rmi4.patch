+
+static int
+rmi_read(uint8_t reg, uint8_t *buf, unsigned len)
+{
+	return touch_read(FJ_TS_ADDR, reg, false, buf, len);
+}
+
+static int
+rmi_write(uint8_t reg, uint8_t val)
+{
+	const uint8_t b[2] = {reg, val};
+	return touch_msg(FJ_TS_ADDR, b, 2, NULL, 0, false);
+}
+
+/* Device control: configured + no-sleep, normal mode; enable all IRQ sources. */
+static int
+rmi_configure(void)
+{
+	uint8_t clr[3];
+	int err = rmi_write(0xff, 0);	/* page 0 */
+	if (!err) {
+		err = rmi_write(st.f01_ctrl, 0x84);
+	}
+	if (!err) {
+		err = rmi_write(st.f01_ctrl + 1, 0x7f);
+	}
+	if (!err) {
+		err = rmi_read(st.f01_data, clr, sizeof(clr));	/* read clears stale IRQs */
+	}
+	return err;
+}
+
+/* PDT scan downward from 0xE9 in 6-byte entries until function 0. */
+static bool
+rmi_setup(void)
+{
+	unsigned irq_base = 0;
+	bool f01 = false, f12 = false;
+	st.probing = true;
+	int err = rmi_write(0xff, 0);
+	st.probing = false;
+	if (err) {
+		printf("SWEET TS: page select err=%d irq=%#x; no RMI4 device at %#x\n",
+		    err, st.irq_status, FJ_TS_ADDR);
+		return false;
+	}
+	for (unsigned a = 0xe9; a >= 0x0a; a -= 6) {
+		uint8_t e[6];
+		err = rmi_read((uint8_t)a, e, sizeof(e));
+		if (err) {
+			printf("SWEET TS: PDT read %#x err=%d\n", a, err);
+			return false;
+		}
+		unsigned nsrc = e[4] & 7u;
+		printf("SWEET TS: PDT %#x fn=%#x query=%#x cmd=%#x ctrl=%#x data=%#x irqs=%u ver=%u\n",
+		    a, e[5], e[0], e[1], e[2], e[3], nsrc, e[4] >> 5);
+		if (e[5] == 0) {
+			break;
+		}
+		if (e[5] == 0x01) {
+			st.f01_ctrl = e[2];
+			st.f01_data = e[3];
+			f01 = true;
+		} else if (e[5] == 0x12) {
+			st.f12_data = e[3];
+			st.f12_irq = (uint8_t)(((1u << nsrc) - 1u) << irq_base);
+			f12 = true;
+		}
+		irq_base += nsrc;
+	}
+	if (!f01 || !f12 || !st.f12_irq || irq_base > 8) {
+		printf("SWEET TS: need F01 and F12 within the first IRQ byte (f01=%d f12=%d irqs=%u)\n",
+		    f01, f12, irq_base);
+		return false;
+	}
+	err = rmi_configure();
+	printf("SWEET TS: F01 ctrl=%#x data=%#x, F12 data=%#x irq-mask=%#x, configure err=%d\n",
+	    st.f01_ctrl, st.f01_data, st.f12_data, st.f12_irq, err);
+	return err == 0;
+}

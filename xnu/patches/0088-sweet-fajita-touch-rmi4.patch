+/* F12 data1: 10 objects x 8 bytes (type, x lo/hi, y lo/hi, z, wx, wy). */
+static int
+rmi_report(unsigned xraw, unsigned yraw, unsigned *dumps)
+{
+	uint8_t f01[2], b[88];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+
+	int err = rmi_read(st.f01_data, f01, sizeof(f01));
+	if (err) {
+		return err;
+	}
+	if (f01[0] & 0x80u) {
+		/* Unconfigured: the IC reset itself. Release fingers, reconfigure. */
+		printf("SWEET TS: device reset (status %#x); reconfiguring\n", f01[0]);
+		touch_report(0, st.x, st.y);
+		return rmi_configure();
+	}
+	if (!(f01[1] & st.f12_irq)) {
+		return 0;
+	}
+	err = rmi_read(st.f12_data, b, sizeof(b));
+	if (err) {
+		return err;
+	}
+	if (*dumps < 4) {
+		++*dumps;
+		printf("SWEET TS: F12 raw %02x %02x %02x %02x %02x %02x %02x %02x | %02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7],
+		    b[8], b[9], b[10], b[11], b[12], b[13], b[14], b[15]);
+	}
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		const uint8_t *o = b + 8u * i;
+		if (o[0] != 1u && o[0] != 2u) {	/* finger or stylus */
+			continue;
+		}
+		unsigned xr = ((o[2] & 0x0fu) << 8) | o[1];
+		unsigned yr = ((o[4] & 0x0fu) << 8) | o[3];
+		x[i] = (int)(xr * 1080u / xraw);
+		y[i] = (int)(yr * 2340u / yraw);
+		mask |= 1u << i;
+	}
+	touch_report(mask, x, y);
+	return 0;

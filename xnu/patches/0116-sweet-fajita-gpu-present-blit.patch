+/* One full-screen layer through the GPU present blit into flip buffer `buffer`; false: do the CPU copy. */
+bool
+AppleCLCD::gpuPresent(const uint8_t *rec, unsigned buffer)
+{
+	uint32_t mask = get32(rec, 0x104), layer = SWEET_FB_LAYERS;
+	for (uint32_t l = 0; l < SWEET_FB_LAYERS; l++) {
+		if ((mask & (1u << l)) && get32(rec, 0x54 + 4 * l) != 0) {
+			if (layer != SWEET_FB_LAYERS) {
+				return false;			/* more than one layer: CPU path */
+			}
+			layer = l;
+		}
+	}
+	if (layer == SWEET_FB_LAYERS) {
+		return false;
+	}
+	if (!sweet_present_dst_mapped) {
+		if (sweet_gpu_map(PRESENT_DST_IOVA, sweet_flip_pa[0], 2 * FLIP_OFFSET)) {
+			sweet_gpublit_off("scan-out buffers not mappable");
+			return false;
+		}
+		sweet_present_dst_mapped = true;
+	}
+	SweetSurface *s = sweet_surface_copy(get32(rec, 0x54 + 4 * layer));
+	if (s == NULL || s == fSurface || s->memory == NULL || (s->bytesPerElement && s->bytesPerElement != 4) ||
+	    s->elementWidth != 1 || s->elementHeight != 1 || (s->bytesPerRow & 63) || (s->offset & 15)) {
+		OSSafeReleaseNULL(s);
+		return false;
+	}
+	const uint8_t *a = rec + 0x64 + 16 * layer, *b = rec + 0xc4 + 16 * layer;
+	int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4), sw = (int32_t)get32(a, 8), sh = (int32_t)get32(a, 12);
+	int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4), dw = (int32_t)get32(b, 8), dh = (int32_t)get32(b, 12);
+	if (sx < 0 || sy < 0) {
+		sx = sy = 0;
+	}
+	if (sw <= 0 || sh <= 0 || sx + sw > (int32_t)s->width || sy + sh > (int32_t)s->height) {
+		sw = (int32_t)s->width - sx;
+		sh = (int32_t)s->height - sy;
+	}
+	if (dx < 0 || dy < 0) {
+		dx = dy = 0;
+	}
+	if (dw <= 0 || dh <= 0) {
+		dw = (int32_t)fLogicalW;
+		dh = (int32_t)fLogicalH;
+	}
+	/* Presented (logical) display -> panel, scaled. */
+	uint32_t px = (uint32_t)((int64_t)dx * fWidth / fLogicalW), py = (uint32_t)((int64_t)dy * fHeight / fLogicalH);
+	uint32_t pw = (uint32_t)((int64_t)dw * fWidth / fLogicalW), ph = (uint32_t)((int64_t)dh * fHeight / fLogicalH);
+	if (px + pw > fWidth) {
+		pw = fWidth - px;
+	}
+	if (py + ph > fHeight) {
+		ph = fHeight - py;
+	}
+	uint64_t src = sweet_present_src(s);
+	uint64_t ns = 0;
+	int rc = (src == 0 || sw <= 0 || sh <= 0 || pw == 0 || ph == 0) ? -2 :
+	    sweet_gpu_present_blit(src + s->offset, s->width, s->height, s->bytesPerRow, (uint32_t)sx, (uint32_t)sy,
+	    (uint32_t)sw, (uint32_t)sh, PRESENT_DST_IOVA + FLIP_OFFSET * buffer, FLIP_STRIDE, px, py, pw, ph, &ns);
+	if (sweet_gpublit_logged < 6 || rc) {
+		sweet_gpublit_logged++;
+		printf("SWEET FLIP: GPU blit surface %u %dx%d+%d+%d -> panel %ux%u+%u+%u into buffer %u: %s, %llu us\n",
+		    s->id, sw, sh, sx, sy, pw, ph, px, py, buffer, rc == 0 ? "done" : rc == -2 ? "NOT MAPPABLE" : "FAILED",
+		    ns / 1000);
+	}
+	s->release();
+	if (rc) {
+		sweet_gpublit_off(rc == -2 ? "source not mappable" : "blit failed or timed out");
+		return false;
+	}
+	sweet_fb_copy_ns += ns;
+	sweet_fb_presents++;
+	return true;
+}

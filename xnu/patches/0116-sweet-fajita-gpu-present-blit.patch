+/*
+ * 0116 GPU present blit (sweetfb_gpublit=1, needs sweetfb_flip=1): the frame goes into the back buffer by
+ * the A6xx 2D engine (sweet_gpu_present_blit in bsd/dev/sweet_a630.c), scaled from the presented
+ * 1125x2436 display onto the whole 1080x2340 panel instead of the CPU copy's centred crop; touch follows
+ * (sweet_fb_scaled). GPU addresses (below the 8 GiB client windows, apart from the kernel's own): both
+ * scan-out buffers at 0x180000000 (one map of the 24 MiB after the splash buffer), source surfaces in 4
+ * cached 16 MiB slots from 0x190000000, keyed by surface id and memory. Any failure turns the path off for
+ * the boot (CPU copy and centred touch again).
+ */
+#define PRESENT_DST_IOVA	0x180000000ULL
+#define PRESENT_SRC_IOVA	0x190000000ULL
+#define PRESENT_SLOT		0x1000000ULL
+#define PRESENT_SLOTS		4
+
+static bool sweet_gpublit_on, sweet_present_dst_mapped;
+static unsigned sweet_gpublit_logged;
+static struct { uint32_t id; const void *mem; } sweet_present_slot[PRESENT_SLOTS];
+static unsigned sweet_present_slot_next;
+static uint64_t sweet_present_pages[PRESENT_SLOT / 4096];
+
+static void
+sweet_gpublit_init(void)
+{
+	uint32_t on = 0;
+	if (sweet_flip_on && PE_parse_boot_argn("sweetfb_gpublit", &on, sizeof(on)) && on) {
+		sweet_gpublit_on = true;
+		sweet_fb_scaled = 1;
+		printf("SWEET FLIP: GPU present blit on (scaled to the panel)\n");
+	}
+}
+
+static void
+sweet_gpublit_off(const char *why)
+{
+	sweet_gpublit_on = false;
+	sweet_fb_scaled = 0;
+	printf("SWEET FLIP: GPU present blit off (%s); CPU copy from now on\n", why);
+}
+
+/* The source surface's GPU address (mapped into a slot on first use), 0 if it cannot be mapped. */
+static uint64_t
+sweet_present_src(SweetSurface *s)
+{
+	for (unsigned i = 0; i < PRESENT_SLOTS; i++) {
+		if (sweet_present_slot[i].id == s->id && sweet_present_slot[i].mem == s->memory) {
+			return PRESENT_SRC_IOVA + PRESENT_SLOT * i;
+		}
+	}
+	uint64_t len = round_page((uint64_t)s->offset + (uint64_t)s->bytesPerRow * s->height);
+	if (len > PRESENT_SLOT || len > s->memory->getLength()) {
+		return 0;
+	}
+	uint32_t n = (uint32_t)(len / 4096);
+	for (uint32_t i = 0; i < n; i++) {
+		IOByteCount seg = 0;
+		addr64_t pa = s->memory->getPhysicalSegment((IOByteCount)i * 4096, &seg, kIOMemoryMapperNone);
+		if (pa == 0 || (pa & 0xfff)) {
+			return 0;
+		}
+		sweet_present_pages[i] = pa;
+	}
+	unsigned slot = sweet_present_slot_next++ % PRESENT_SLOTS;
+	sweet_present_slot[slot].id = 0;
+	uint64_t iova = PRESENT_SRC_IOVA + PRESENT_SLOT * slot;
+	if (sweet_gpu_map_pages(iova, sweet_present_pages, n)) {
+		return 0;
+	}
+	sweet_present_slot[slot].id = s->id;
+	sweet_present_slot[slot].mem = s->memory;
+	return iova;
+}

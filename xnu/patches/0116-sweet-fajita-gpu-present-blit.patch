+/*
+ * 0116: the present blit for SweetFramebuffer. One A6xx 2D-engine blit with linear filtering from a
+ * GPU-mapped BGRA8 surface (src, pitch a multiple of 64) to a scan-out buffer (dst, pitch a multiple of
+ * 64), scaling (sx,sy,sw,sh) onto (dx,dy,dw,dh). Sequence and values from Mesa
+ * gallium/drivers/freedreno/a6xx/fd6_blitter.cc (emit_setup, emit_blit_texture_setup, emit_blit_src/dst,
+ * emit_blit_setup, emit_blit_fini), offsets/fields from msm a6xx.xml / a6xx_enums.xml / adreno_common.xml:
+ * CCU flush + invalidate, RB_CCU_CNTL in sysmem (bypass) mode = 0x10000000 for a630 (color CCU at
+ * 2 x 64 KiB, freedreno_devices.py), FMT6_8_8_8_8_UNORM (0x30) with the same swap (WZYX) both sides so BGRA
+ * stays BGRA, R2D_UNORM8, RB_DBG_ECO_CNTL bit 24 around the blit (quirk QCTDD04536579; a630 base value
+ * 0x04100000), CP_BLIT(BLIT_OP_SCALE), CCU colour flush. RM6_BLIT2DSCALE is a no-op on this SQE (pm4 xml),
+ * not sent. The IB lives in one arena chunk at a fixed GPU address; callers serialize.
+ */
+#define CP_WAIT_FOR_IDLE	0x26
+#define CP_BLIT			0x2c
+#define BLIT_OP_SCALE		3
+#define PC_CCU_FLUSH_DEPTH_TS	0x1c
+#define PC_CCU_FLUSH_COLOR_TS	0x1d
+#define VA_PRESENT_IB		0x1a0000000ULL
+#define FMT6_8888_UNORM		0x30u
+#define RB_DBG_ECO_CNTL_A630	0x04100000u
+
+static uint32_t
+pkt4(uint32_t reg, uint32_t cnt)
+{
+	return 0x40000000 | cnt | (pm4_parity(cnt) << 7) | ((reg & 0x3ffff) << 8) | (pm4_parity(reg) << 27);
+}
+
+static uint64_t present_ib_pa;
+static vm_offset_t present_ib_kva;
+
+int
+sweet_gpu_present_blit(uint64_t src, uint32_t src_w, uint32_t src_h, uint32_t src_pitch,
+    uint32_t sx, uint32_t sy, uint32_t sw, uint32_t sh, uint64_t dst, uint32_t dst_pitch,
+    uint32_t dx, uint32_t dy, uint32_t dw, uint32_t dh, uint64_t *gpu_ns)
+{
+	if (!sweet_gpu_is_ready() || (src & 15) || (dst & 63) || (src_pitch & 63) || (dst_pitch & 63) ||
+	    !sw || !sh || !dw || !dh || src_w > 16384 || src_h > 16384 || dx + dw > 16384 || dy + dh > 16384) {
+		return -1;
+	}
+	if (!present_ib_kva) {
+		if (sweet_gpu_bo_alloc(ARENA_CHUNK, ARENA_CHUNK, &present_ib_pa, &present_ib_kva) ||
+		    sweet_gpu_map(VA_PRESENT_IB, present_ib_pa, ARENA_CHUNK)) {
+			present_ib_kva = 0;
+			return -1;
+		}
+	}
+	uint32_t d[96], n = 0;
+	uint64_t ts = VA_SCRATCH + 0x200;			/* flush timestamps land here, unused */
+	static const uint32_t pre[4] = { PC_CCU_FLUSH_COLOR_TS, PC_CCU_FLUSH_DEPTH_TS, 0, 0 };
+	for (unsigned i = 0; i < 2; i++) {			/* emit_setup: CCU flush + invalidate */
+		d[n++] = pkt7(CP_EVENT_WRITE, 4);
+		d[n++] = pre[i];
+		d[n++] = (uint32_t)ts;
+		d[n++] = (uint32_t)(ts >> 32);
+		d[n++] = 0;
+	}
+	d[n++] = pkt7(CP_EVENT_WRITE, 1);
+	d[n++] = PC_CCU_INVALIDATE_COLOR;
+	d[n++] = pkt7(CP_EVENT_WRITE, 1);
+	d[n++] = PC_CCU_INVALIDATE_DEPTH;
+	d[n++] = pkt7(CP_WAIT_FOR_IDLE, 0);
+	d[n++] = pkt4(0x8e07, 1);				/* RB_CCU_CNTL: sysmem (bypass) */
+	d[n++] = 0x10000000;
+	d[n++] = pkt4(0x8401, 6);				/* GRAS_A2D_SRC_XMIN..YMAX (24.8), DEST_TL/BR */
+	d[n++] = sx << 8;
+	d[n++] = (sx + sw - 1) << 8;
+	d[n++] = sy << 8;
+	d[n++] = (sy + sh - 1) << 8;
+	d[n++] = dx | (dy << 16);
+	d[n++] = (dx + dw - 1) | ((dy + dh - 1) << 16);
+	uint32_t cntl = (0xfu << 20) | (FMT6_8888_UNORM << 8);	/* MASK, COLOR_FORMAT, IFMT R2D_UNORM8, ROTATE_0 */
+	d[n++] = pkt4(0x8c00, 2);				/* RB_A2D_BLT_CNTL, RB_A2D_PIXEL_CNTL */
+	d[n++] = cntl;
+	d[n++] = 0;
+	d[n++] = pkt4(0x8400, 1);				/* GRAS_A2D_BLT_CNTL */
+	d[n++] = cntl;
+	d[n++] = pkt4(0xacc0, 1);				/* SP_A2D_OUTPUT_INFO: float, 8888, mask */
+	d[n++] = (FMT6_8888_UNORM << 3) | (0xfu << 12);
+	d[n++] = pkt4(0xb4c0, 5);				/* TPL1_A2D_SRC_TEXTURE_INFO/SIZE/BASE/PITCH */
+	d[n++] = FMT6_8888_UNORM | (1u << 16) | (1u << 20) | (1u << 22);	/* linear, WZYX, filter, unk20/22 */
+	d[n++] = src_w | (src_h << 15);
+	d[n++] = (uint32_t)src;
+	d[n++] = (uint32_t)(src >> 32);
+	d[n++] = (src_pitch >> 6) << 9;
+	d[n++] = pkt4(0x8c17, 4);				/* RB_A2D_DEST_BUFFER_INFO/BASE/PITCH */
+	d[n++] = FMT6_8888_UNORM;				/* linear, WZYX */
+	d[n++] = (uint32_t)dst;
+	d[n++] = (uint32_t)(dst >> 32);
+	d[n++] = dst_pitch >> 6;
+	d[n++] = pkt7(CP_WAIT_FOR_IDLE, 0);			/* emit_blit_fini */
+	d[n++] = pkt4(0x8e04, 1);				/* RB_DBG_ECO_CNTL b24 for 2D blits */
+	d[n++] = RB_DBG_ECO_CNTL_A630 | (1u << 24);
+	d[n++] = pkt7(CP_BLIT, 1);
+	d[n++] = BLIT_OP_SCALE;
+	d[n++] = pkt7(CP_WAIT_FOR_IDLE, 0);
+	d[n++] = pkt4(0x8e04, 1);
+	d[n++] = RB_DBG_ECO_CNTL_A630;
+	d[n++] = pkt7(CP_EVENT_WRITE, 4);			/* the blit writes through CCU colour */
+	d[n++] = PC_CCU_FLUSH_COLOR_TS;
+	d[n++] = (uint32_t)ts;
+	d[n++] = (uint32_t)(ts >> 32);
+	d[n++] = 1;
+	d[n++] = pkt7(CP_WAIT_FOR_IDLE, 0);
+	for (uint32_t i = 0; i < n; i++) {
+		wr(present_ib_kva + 4 * i, d[i]);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint64_t t0 = mach_absolute_time(), ns;
+	uint32_t seq;
+	if (sweet_gpu_submit(VA_PRESENT_IB, n, &seq)) {
+		return -1;
+	}
+	int rc = sweet_gpu_wait_ns(seq, 100000000ULL);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	if (gpu_ns) {
+		*gpu_ns = ns;
+	}
+	return rc;
+}

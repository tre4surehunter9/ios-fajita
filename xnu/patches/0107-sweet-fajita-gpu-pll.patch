+/*
+ * The GPU core clock by hand (0107, sweetgpuclk=N, 1..7). Facts from
+ * downstream gpucc-sdm845.c (sdm845 v2): gpu_cc_pll0 is a Fabia PLL at gpucc
+ * +0x0; gx_gfx3d_clk_src is an RCG at +0x101c (CMD) / +0x1020 (CFG), no M/N,
+ * input 1 = crc_div = PLL0 out_even / 1, every OPP at divider 1, so PLL0 runs
+ * at the GPU frequency. Fabia register offsets and the enable order are
+ * mainline clk-alpha-pll.c's (alpha_pll_fabia_enable). The rail: the GMU's
+ * boot vote (gx_up_and_back) is set to this level's perf-table indices
+ * before GX comes up. If the PLL does not lock, the RCG stays on XO.
+ */
+#define PLL0_MODE		0x0000
+#define PLL0_L_VAL		0x0004
+#define PLL0_USER_CTL		0x000c
+#define PLL0_STATUS		0x0024
+#define PLL0_OPMODE		0x002c
+#define PLL0_FRAC		0x0038
+#define PLL_OUTCTRL		(1u << 0)
+#define PLL_RESET_N		(1u << 2)
+#define PLL_LOCK_DET		(1u << 31)
+#define PLL_OUT_MASK		0x7u		/* main, even, odd outputs */
+#define PLL_EVEN_DIV_MASK	(0xfu << 8)
+#define GFX3D_CMD_RCGR		0x101c
+#define GFX3D_CFG_RCGR		0x1020
+#define RCG_UPDATE		(1u << 0)
+#define RCG_ROOT_OFF		(1u << 31)
+
+static void
+gpu_clk_set(uint32_t level)
+{
+	vm_offset_t cc = w.gpucc;
+	uint64_t hz = (uint64_t)gpu_khz[level] * 1000;
+	uint32_t l = (uint32_t)(hz / 19200000), frac = (uint32_t)(((hz % 19200000) << 16) / 19200000);
+	printf("SWEET GPU: clk before: pll0 mode 0x%08x L 0x%x frac 0x%x opmode 0x%x user 0x%x status 0x%x, "
+	    "gfx3d rcg 0x%x/0x%x\n", rd(cc + PLL0_MODE), rd(cc + PLL0_L_VAL), rd(cc + PLL0_FRAC), rd(cc + PLL0_OPMODE),
+	    rd(cc + PLL0_USER_CTL), rd(cc + PLL0_STATUS), rd(cc + GFX3D_CMD_RCGR), rd(cc + GFX3D_CFG_RCGR));
+	if ((rd(cc + GFX3D_CFG_RCGR) & 0x700) != 0) {
+		printf("SWEET GPU: clk: gfx3d not on XO, left alone\n");
+		return;
+	}
+	wr(cc + PLL0_MODE, rd(cc + PLL0_MODE) & ~PLL_OUTCTRL);
+	wr(cc + PLL0_OPMODE, 0);				/* STANDBY */
+	wr(cc + PLL0_L_VAL, l);
+	wr(cc + PLL0_FRAC, frac);
+	wr(cc + PLL0_MODE, rd(cc + PLL0_MODE) | PLL_RESET_N);
+	wr(cc + PLL0_OPMODE, 1);				/* RUN */
+	unsigned us = 0;
+	while (!(rd(cc + PLL0_MODE) & PLL_LOCK_DET) && us < 1000) {
+		delay(10);
+		us += 10;
+	}
+	uint32_t mode = rd(cc + PLL0_MODE);
+	if (!(mode & PLL_LOCK_DET)) {
+		printf("SWEET GPU: clk: PLL0 NOT LOCKED at %u MHz (mode 0x%08x status 0x%x); gfx3d stays on XO\n",
+		    gpu_khz[level] / 1000, mode, rd(cc + PLL0_STATUS));
+		return;
+	}
+	wr(cc + PLL0_USER_CTL, (rd(cc + PLL0_USER_CTL) & ~PLL_EVEN_DIV_MASK) | PLL_OUT_MASK);
+	wr(cc + PLL0_MODE, rd(cc + PLL0_MODE) | PLL_OUTCTRL);
+	wr(cc + GFX3D_CFG_RCGR, (1u << 8) | 1u);		/* input 1 (crc_div), divider 1 */
+	wr(cc + GFX3D_CMD_RCGR, rd(cc + GFX3D_CMD_RCGR) | RCG_UPDATE);
+	us = 0;
+	while ((rd(cc + GFX3D_CMD_RCGR) & RCG_UPDATE) && us < 1000) {
+		delay(10);
+		us += 10;
+	}
+	uint32_t cmd = rd(cc + GFX3D_CMD_RCGR);
+	printf("SWEET GPU: clk: PLL0 locked at %u MHz (L 0x%x frac 0x%x, mode 0x%08x), gfx3d rcg 0x%x/0x%x%s\n",
+	    gpu_khz[level] / 1000, l, frac, rd(cc + PLL0_MODE), cmd, rd(cc + GFX3D_CFG_RCGR),
+	    (cmd & RCG_UPDATE) ? " UPDATE STUCK" : (cmd & RCG_ROOT_OFF) ? " ROOT OFF" : "");
 }
 

diff --git a/iokit/Kernel/arm/SweetPlatformExpert.cpp b/iokit/Kernel/arm/SweetPlatformExpert.cpp
index 0631685..82db0e1 100644
--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -9,6 +9,42 @@
 #include <IOKit/IOPlatformExpert.h>
 #include <IOKit/IODeviceTreeSupport.h>
 #include <IOKit/IOLib.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+
+/*
+ * Boot-arg sweetbusy=N: N, 2N and 3N seconds after the platform expert
+ * starts, log every IOService whose busy count is not zero. A service that
+ * never finishes matching keeps the registry from going quiet, and
+ * SystemConfiguration (__wait_for_IOKit_to_quiesce) then blocks forever,
+ * e.g. Settings → About on fajita. Busy counts propagate to ancestors: the
+ * deepest busy entries are the culprits.
+ */
+static void
+sweet_busy_report(void *arg, wait_result_t wr __unused)
+{
+	uint32_t secs = (uint32_t)(uintptr_t)arg;
+	for (int round = 1; round <= 3; round++) {
+		IOSleep(secs * 1000);
+		unsigned busy = 0;
+		IORegistryIterator *it = IORegistryIterator::iterateOver(gIOServicePlane,
+		    kIORegistryIterateRecursively);
+		if (it != NULL) {
+			IORegistryEntry *entry;
+			while ((entry = it->getNextObject()) != NULL) {
+				IOService *service = OSDynamicCast(IOService, entry);
+				if (service != NULL && service->getBusyState() != 0) {
+					busy++;
+					IOLog("SWEET BUSY: %s <%s> busy=%u depth=%u\n", service->getName(),
+					    service->getMetaClass()->getClassName(),
+					    (unsigned)service->getBusyState(), (unsigned)service->getDepth(gIOServicePlane));
+				}
+			}
+			it->release();
+		}
+		IOLog("SWEET BUSY: round %d after %u s: %u busy services\n", round, secs * round, busy);
+	}
+}
 
 class SweetPlatformExpert : public IODTPlatformExpert {
 	OSDeclareDefaultStructors(SweetPlatformExpert);
@@ -31,6 +67,12 @@ SweetPlatformExpert::start(IOService *provider)
 	}
 	registerService();
 	IOLog("SWEET: platform expert registered\n");
+	uint32_t busy_secs = 0;
+	thread_t thread;
+	if (PE_parse_boot_argn("sweetbusy", &busy_secs, sizeof(busy_secs)) && busy_secs != 0 &&
+	    kernel_thread_start(sweet_busy_report, (void *)(uintptr_t)busy_secs, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
 	return true;
 }
 
